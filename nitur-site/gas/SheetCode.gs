    risk ? '=HYPERLINK("#gid=' + risk.getSheetId() + '","מש""קיות שדורשות טיפול")'
         : '="מש""קיות שדורשות טיפול (לא נבנה)"', '#00897B');

  const dash = ss.getSheetByName('דשבורד');
  bigButton_(home, 5, 9, 4,
    dash ? '=HYPERLINK("#gid=' + dash.getSheetId() + '","דשבורד")'
