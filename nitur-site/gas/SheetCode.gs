    .setValue('הלחצן הראשון מקפיץ לשורה הפנויה. שם מסמנים "תחילת תצפית" ומתחילים למלא.')
    .setFontSize(10).setFontColor(THEME.INK_SOFT)
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  home.setRowHeight(8, 22);
  home.setRowHeight(9, 14);

  section_(home, 10, 'חיפוש מש"קית');

