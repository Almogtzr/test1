      .whenNumberGreaterThanOrEqualTo(85).setBackground(THEME.S5).build()
  ]);

  const GROUPS = [
    ['הזנה ותפעול', ['ניטור תצפיות', CFG.MAPPING_SHEET, CFG.CARD_SHEET], '#E3F2FD'],
    ['תמונת מצב', ['דשבורד', CFG.NATIONAL_SHEET, CFG.MADMACH_SHEET, CFG.TREND_SHEET,
                   CFG.SNAPSHOT_SHEET], '#B2DFDB'],
    ['ניתוח ביצועים', ['ניתוח לפי מש"קית', 'ניתוח לפי רשות',
                       CFG.MANHAD_SHEET, CFG.MEFAKEDET_SHEET,
                       'ניתוח לפי בית ספר', 'ניתוח לפי שיפט'], '#BBDEFB'],
    ['פעילות ויעדים', ['פעילות מנה"דים', 'פעילות מפקדות',
                       'ניתוח מתצפתים'], '#D1C4E9'],
    ['ניהול ובקרה', [CFG.ALERTS_SHEET, CFG.RECO_SHEET, CFG.RISK_SHEET,
                     'חוסרים וטיפול', CFG.GAPS_SHEET,
                     'איכות נתונים'], '#FFE0B2'],
    ['מקורות וכלים', ['נתונים', CFG.HELPER_SHEET, CFG.LOG_SHEET], '#ECEFF1']
  ];

  const placed = {};
  let row = 16;

  GROUPS.forEach(function (g) {
    const exist = g[1].filter(function (nm) { return !!ss.getSheetByName(nm); });
    if (!exist.length) return;
    section_(home, row, g[0]);
    row++;
    let col = 1;
    exist.forEach(function (nm) {
      placed[nm] = true;
      linkTile_(home, row, col, 4, nm, ss.getSheetByName(nm).getSheetId(), g[2]);
      col += 4;
      if (col > 9) { col = 1; home.setRowHeight(row, 34); row++; }
    });
    if (col !== 1) { home.setRowHeight(row, 34); row++; }
    home.setRowHeight(row, 10);
    row++;
  });

  const extra = ss.getSheets().filter(function (s) {
    const nm = s.getName();
    return nm !== 'מסך בית' && !placed[nm] && !s.isSheetHidden();
  });
  if (extra.length) {
    section_(home, row, 'גיליונות נוספים');
    row++;
    let col = 1;
    extra.forEach(function (s) {
      linkTile_(home, row, col, 4, s.getName(), s.getSheetId(), '#F5F5F5');
      col += 4;
      if (col > 9) { col = 1; home.setRowHeight(row, 34); row++; }
    });
    if (col !== 1) { home.setRowHeight(row, 34); row++; }
