/**
 * השלב בתוך ההרצה היומית. עובד פעם בשבוע ויוצא בשאר הימים.
 */
function pasteLookupValuesWeekly() {
  const props = PropertiesService.getDocumentProperties();
  const KEY = 'LAST_PASTE_VALUES';
  const last = Number(props.getProperty(KEY) || 0);
  const gap = last ? (Date.now() - last) / 86400000 : 999;

  if (gap < 0.5) return;                         // כבר רץ היום

  const isDay = new Date().getDay() === Number(CFG.PASTE_DAY);
  const tooLong = gap >= Number(CFG.PASTE_MAX_GAP_DAYS || 8);
  if (!isDay && !tooLong) return;                // לא היום

  const rows = pasteRun_({ silent: true });
  props.setProperty(KEY, String(Date.now()));
  return rows;
}

function installLookupFormulas() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא גיליון ההזנה'); return; }

  const map = ss.getSheetByName(CFG.MAPPING_SHEET);
  if (!map) { ss.toast('הרץ קודם "סנכרן שיוך"'); return; }

  // שורת הנתונים הראשונה במיפוי
  let hRow = 1;
  for (let r = 1; r <= Math.min(map.getLastRow(), 4); r++) {
    if (String(map.getRange(r, 1).getValue()).trim() === MAP_HEAD[0]) { hRow = r; break; }
  }
  const F = hRow + 1;
  const Q = "'" + CFG.MAPPING_SHEET + "'!";
  const REF = Q + '$A$' + F + ':$J';

  const m = colMap_(sh);
  const iMash = findCol_(m, 'משקית');
  if (iMash < 0) { ss.toast('לא נמצאה עמודת מש"קית'); return; }
  const ML = colLetter_(iMash);

  // הפלוגה נגזרת מהרשות ולא מהמש"קית, ולכן יש לה טווח משלה
  const iRashut = findCol_(m, 'רשות');
  const RL = iRashut >= 0 ? colLetter_(iRashut) : '';
  let PREF = '';
  const plugSheet = ss.getSheetByName(CFG.PLUGAH_SHEET);
  if (plugSheet) {
    let pRow = 1;
    for (let r = 1; r <= Math.min(plugSheet.getLastRow(), 4); r++) {
      if (String(plugSheet.getRange(r, 1).getValue()).trim() === 'רשות') { pRow = r; break; }
    }
    PREF = "'" + CFG.PLUGAH_SHEET + "'!$A$" + (pRow + 1) + ':$B';
  }

  // כותרת בגיליון ההזנה -> מספר העמודה בגיליון "מיפוי"
  const ALL = {
    'מ.א מש"קית': 2,
    'מחזור':      3,
    'פלוגה':      4,
    'מחוז':       5,
    'רשות':       6,
    'מפקדת':      7,
    'מ.א מפקדת':  8,
    'מנהד אזורי': 9
  };

  /* ---------- טווח ההתקנה ---------- */
  const startRow = Math.max(CFG.LOOKUP_START_ROW || CFG.FIRST_ROW, CFG.FIRST_ROW);
  const lastData = Math.max(lastDataRow_(sh, findCol_(m, 'תאריך')), CFG.FIRST_ROW);
  const until = Math.min(Math.max(lastData + 200, startRow + 300), sh.getMaxRows());

  if (until < startRow) { ss.toast('אין שורות להתקנה'); return; }
  const n = until - startRow + 1;

  const cols = (CFG.LOOKUP_COLS || []).filter(function (t) {
    return ALL[t] && findCol_(m, t) >= 0;
  });
  if (!cols.length) { ss.toast('לא נמצאו עמודות יעד'); return; }

  const done = [];
  let written = 0, kept = 0;

  cols.forEach(function (title) {
    const k = ALL[title];
    const idx = findCol_(m, title);
    const rng = sh.getRange(startRow, idx + 1, n, 1);

    const curF = rng.getFormulas();
    const curV = rng.getValues();
    const outF = [];

    for (let x = 0; x < n; x++) {
      const r = startRow + x;
      const hasFormula = String(curF[x][0] || '') !== '';
      const hasValue = String(curV[x][0] || '').trim() !== '';

      // ערך קיים שאינו נוסחה — לא נוגעים בו
      if (hasValue && !hasFormula) { outF.push([curV[x][0]]); kept++; continue; }

      // פלוגה — לפי הרשות, מהגיליון "פלוגות לפי רשות"
      if (title === 'פלוגה' && PREF && RL) {
        const rk = '$' + RL + r;
        outF.push(['=IF(' + rk + '="","",IFERROR(VLOOKUP(' +
                   rk + ',' + PREF + ',2,FALSE),""))']);
        written++;
        continue;
      }

      const mk = '$' + ML + r;
      outF.push(['=IF(' + mk + '="","",IFERROR(VLOOKUP(' +
                 mk + ',' + REF + ',' + k + ',FALSE),""))']);
      written++;
    }

    rng.setFormulas(outF);
    rng.setFontColor('#000000').setBackground(THEME.SURFACE);
    done.push(title);
  });

  const msg = done.length
    ? 'הותקנו נוסחאות ב-' + done.length + ' עמודות:\n' +
      done.join('  ·  ') + '\n\n' +
      'טווח: שורות ' + startRow + ' עד ' + until + '.\n' +
      'נכתבו ' + written + ' תאים.\n' +
      'דולגו ' + kept + ' תאים שכבר היה בהם ערך.\n\n' +
      'כל מה שמעל שורה ' + startRow + ' לא נגע כלל.\n\n' +
      'הרץ "הגדר הרשאות" כדי לנעול את העמודות לעריכה.'
    : 'לא נמצאו עמודות יעד בגיליון ההזנה.';

  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('נוסחאות שליפה', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'נוסחאות שליפה', 20); } catch (e2) {}
  }
}


/* ============================================================================
   פרק 43 — תלות: רשות -> בית ספר
   ============================================================================
   אותה שיטה של רשימת השיעורים: גיליון עזר שורה-מול-שורה,
   ואימות נתונים שמצביע על השורה המתאימה בו.
   ============================================================================ */

function syncSchoolValidation() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  const reg = ss.getSheetByName(CFG.SCHOOLS_SHEET);
  if (!sh) { ss.toast('לא נמצא גיליון ההזנה'); return; }
  if (!reg) { ss.toast('הרץ קודם "רשימת בתי ספר"'); return; }

  // שורת הנתונים הראשונה ברשימת בתי הספר
  let hRow = 1;
  for (let r = 1; r <= Math.min(reg.getLastRow(), 4); r++) {
    if (String(reg.getRange(r, 1).getValue()).trim() === 'רשות') { hRow = r; break; }
  }
  const first = hRow + 1;

  const m = colMap_(sh);
  const iRashut = findCol_(m, 'רשות');
  const iSchool = findCol_(m, 'בית ספר');
  if (iRashut < 0 || iSchool < 0) {
    ss.toast('לא נמצאו עמודות רשות או בית ספר');
    return;
  }
  const RL = colLetter_(iRashut);

  const lastData = Math.max(lastDataRow_(sh, findCol_(m, 'תאריך')), CFG.FIRST_ROW);
  const until = Math.min(Math.max(lastData + 200, CFG.FIRST_ROW + 300),
                         sh.getMaxRows());
  const n = until - CFG.FIRST_ROW + 1;

  /* ---------- גיליון העזר ---------- */
  let hp = ss.getSheetByName(CFG.SCHOOLS_HELPER);
  if (!hp) hp = ss.insertSheet(CFG.SCHOOLS_HELPER);
  hp.clear();
  ensureRows_(hp, until + 10);
  ensureCols_(hp, 120);
  hp.setRightToLeft(true);

  hp.getRange(1, 1, 1, 3).setValues([[
    'גיליון עזר — אל תערוך', 'כל שורה מחזירה את בתי הספר של הרשות ' +
    'שנבחרה באותה שורה בגיליון ההזנה', 'נבנה מחדש בכל הרצה'
  ]]).setFontWeight('bold').setFontColor(THEME.INK_SOFT);

  const RANGE_B = "'" + CFG.SCHOOLS_SHEET + "'!$B$" + first + ":$B";
  const RANGE_A = "'" + CFG.SCHOOLS_SHEET + "'!$A$" + first + ":$A";

  const f = [];
  for (let r = CFG.FIRST_ROW; r <= until; r++) {
    f.push(['=IFERROR(TRANSPOSE(SORT(FILTER(' + RANGE_B + ',' +
            RANGE_A + "='" + CFG.SRC + "'!$" + RL + r + ',' +
            RANGE_B + '<>""))),"")']);
  }
  hp.getRange(CFG.FIRST_ROW, 1, f.length, 1).setFormulas(f);
  SpreadsheetApp.flush();

  /* ---------- אימות הנתונים ---------- */
  const rules = [];
  for (let r = CFG.FIRST_ROW; r <= until; r++) {
    rules.push([SpreadsheetApp.newDataValidation()
      .requireValueInRange(hp.getRange(r, 1, 1, 100), true)
      .setAllowInvalid(true)
      .setHelpText('בחר רשות קודם — הרשימה מציגה רק את בתי הספר שלה')
      .build()]);
  }
  sh.getRange(CFG.FIRST_ROW, iSchool + 1, n, 1).setDataValidations(rules);

  try { hp.hideSheet(); } catch (err) {}

  const msg = 'הרשימה הנפתחת של בתי הספר מסונכרנת לשורות ' +
              CFG.FIRST_ROW + '-' + until + '.\n\n' +
              'בחירת רשות פותחת רק את בתי הספר שלה. ' +
              'להוספת בית ספר — שורה חדשה ב"' + CFG.SCHOOLS_SHEET + '", ' +
              'ואז להריץ את הפעולה הזו שוב.';
  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('רשימות בתי ספר', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'רשימות בתי ספר', 15); } catch (e2) {}
  }
}


