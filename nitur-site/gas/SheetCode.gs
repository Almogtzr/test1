/* ============================================================================
   פרק 39 — תאי הבחירה
   ============================================================================
   שני תאים בלבד, מוגדרים ב-CFG.PICKER_CELLS.

   הנקודה החשובה: כלל עיצוב מותנה גובר על צבע הגופן של התא.
   אם קיים כלל שחופף לתא, כל setFontColor שנריץ עליו יידרס
   מיד. לכן הפונקציה מוחקת קודם כללים חופפים, ורק אז צובעת.
   ============================================================================ */

function fixPickerCells() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const cells = CFG.PICKER_CELLS || [];
  const out = [];

  cells.forEach(function (spec) {
    const sh = ss.getSheetByName(spec[0]);
    if (!sh) { out.push(spec[0] + ' — הגיליון לא קיים'); return; }

    let rng;
    try { rng = sh.getRange(spec[1]); }
    catch (err) { out.push(spec[0] + '!' + spec[1] + ' — טווח לא תקין'); return; }

    // 1. הסרת כללי עיצוב מותנה שחופפים לתא
    let dropped = 0;
    try {
      const r1 = rng.getRow(), r2 = rng.getLastRow();
      const c1 = rng.getColumn(), c2 = rng.getLastColumn();

      const kept = sh.getConditionalFormatRules().filter(function (rule) {
        const hits = rule.getRanges().some(function (rr) {
          return rr.getRow() <= r2 && rr.getLastRow() >= r1 &&
                 rr.getColumn() <= c2 && rr.getLastColumn() >= c1;
        });
        if (hits) dropped++;
        return !hits;
      });
      if (dropped) sh.setConditionalFormatRules(kept);
    } catch (err) {}

    // 2. הצבע והגודל
    try {
      rng.setFontColor('#000000')
         .setFontWeight('bold')
         .setFontSize(14)
         .setFontLine('none')
         .setHorizontalAlignment('center')
         .setVerticalAlignment('middle');
      sh.setRowHeight(rng.getRow(), 36);
    } catch (err) {
      out.push(spec[0] + '!' + spec[1] + ' — ' + err.message);
      return;
    }

    out.push(spec[0] + '!' + spec[1] + '  ✓' +
             (dropped ? '  (הוסרו ' + dropped + ' כללי עיצוב מותנה)' : ''));
  });

  const msg = out.join('\n');
  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('תאי הבחירה', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'תאי הבחירה', 15); } catch (e2) {}
  }
  return msg;
}


/**
 * מוחקת עמודות לפי שם הכותרת, מכל הגיליונות.
 *
 * נחוצה כי גיליון שהקוד כבר לא בונה לא מתעדכן לעולם,
 * ונשאר עם מבנה ישן. הזיהוי לפי שם ולא לפי מיקום, והמחיקה
 * מימין לשמאל כדי שהאינדקסים לא יזוזו תוך כדי.
 */
function dropLegacyColumns() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();

  const targets = (CFG.DROP_COLUMNS || []).map(function (x) {
    return String(x).trim();
  });
  if (!targets.length) return 0;

  const SKIP = (CFG.MANUAL_SHEETS || [])
    .concat(CFG.NO_FORMAT || [])
    .concat([CFG.SRC, CFG.DATA_SHEET, CFG.HELPER_SHEET, CFG.LOG_SHEET]);

  let removed = 0;
  const report = [];

  ss.getSheets().forEach(function (sh) {
    const name = sh.getName();
    if (SKIP.indexOf(name) !== -1) return;
    if (name.indexOf('DO NOT DELETE') === 0) return;

    const lastCol = sh.getLastColumn();
    if (lastCol < 1 || sh.getLastRow() < 1) return;

    // הכותרות יושבות בשורה 1, או בשורה 2 כשיש שורת תיאור
    const hits = {};
    [1, 2].forEach(function (r) {
      if (r > sh.getLastRow()) return;
      let vals;
      try { vals = sh.getRange(r, 1, 1, lastCol).getValues()[0]; }
      catch (err) { return; }
      vals.forEach(function (v, i) {
        if (targets.indexOf(String(v).trim()) !== -1) hits[i + 1] = true;
      });
    });

    const cols = Object.keys(hits).map(Number).sort(function (a, b) {
      return b - a;   // מימין לשמאל
    });
    if (!cols.length) return;

    cols.forEach(function (c) {
      try { sh.deleteColumn(c); removed++; } catch (err) {}
    });
    report.push(name + ': ' + cols.length);
  });

  const msg = removed
    ? 'נמחקו ' + removed + ' עמודות.\n\n' + report.join('\n')
    : 'לא נמצאו עמודות למחיקה.';

  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('הסרת עמודות ישנות', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'הסרת עמודות', 15); } catch (e2) {}
  }
  return removed;
}


