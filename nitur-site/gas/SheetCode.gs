/**
 * מעבירה לקצה השמאלי כל גיליון שהסקריפט לא מתחזק.
 * הסדר היחסי בין הגיליונות שמועברים נשמר.
 */
function arrangeSheets() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const mine = scriptSheets_();

  const active = ss.getActiveSheet();
  const moved = [];

  // עותק של הסדר הנוכחי — getSheets משתנה תוך כדי ההזזות
  const names = ss.getSheets().map(function (sh) { return sh.getName(); });

  names.forEach(function (name) {
    if (mine.indexOf(name) !== -1) return;
    const sh = ss.getSheetByName(name);
    if (!sh) return;
    try {
      ss.setActiveSheet(sh);
      ss.moveActiveSheet(ss.getNumSheets());   // לסוף = לשמאל
      moved.push(name);
    } catch (err) {}
  });

  try { ss.setActiveSheet(active); } catch (err) {}

  const msg = moved.length
    ? 'הועברו לצד שמאל ' + moved.length + ' לשוניות:\n\n' + moved.join('\n')
    : 'כל הלשוניות כבר מסודרות.';

  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('סדר הלשוניות', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'סדר הלשוניות', 15); } catch (e2) {}
  }
  return moved.length;
}


