function runState_() {
  try {
    return JSON.parse(PropertiesService.getDocumentProperties()
      .getProperty(RUN_PROP) || 'null');
  } catch (err) { return null; }
}

function saveState_(st) {
  PropertiesService.getDocumentProperties()
    .setProperty(RUN_PROP, JSON.stringify(st));
}

function clearState_() {
  try { PropertiesService.getDocumentProperties().deleteProperty(RUN_PROP); }
  catch (err) {}
}

function killContinuations_() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === CONT_FN) ScriptApp.deleteTrigger(t);
  });
}


/** מתחיל הרצה מפוצלת. kind: 'full' או 'daily'. */
function startRun_(kind, extra) {
  killContinuations_();
  const st = {
    kind: kind, i: 0, t0: Date.now(),
    took: {}, errors: [], extra: extra || {}
  };
  saveState_(st);
  executeChunk_();
}


function executeChunk_() {
  const ss = SpreadsheetApp.getActive();
  const st = runState_();
  if (!st) return;

  const steps = plan_(st.kind);
  const title = st.kind === 'daily' ? 'רענון יומי' : 'הפעלה מלאה';
  const chunk = ((CFG.DAILY || {}).chunkSec || 240) * 1000;
  const c0 = Date.now();

  let hist = {};
  try {
    hist = JSON.parse(PropertiesService.getDocumentProperties()
      .getProperty('STEP_TIMES') || '{}');
  } catch (err) { hist = {}; }

  const eta = function (from) {
    let ms = 0;
    for (let k = from; k < steps.length; k++) ms += hist[steps[k][0]] || 8000;
    return ms;
  };

  // שומר: נוצר לפני שמתחילים לעבוד. אם גוגל תהרוג את
  // ההרצה באמצע שלב ארוך, הוא יתעורר וימשיך מהמצב
  // השמור האחרון. בלעדיו הרג באמצע עוצר הכול לתמיד.
  killContinuations_();
  try {
    ScriptApp.newTrigger(CONT_FN).timeBased().after(330 * 1000).create();
  } catch (err) {}

  while (st.i < steps.length) {

    const label = steps[st.i][0];
    try {
      ss.toast('[' + (st.i + 1) + '/' + steps.length + ']  ' + label + '\n' +
               'עברו ' + fmtMMSS_(Date.now() - st.t0) +
               '   ·   צפי סיום בעוד ' + fmtMMSS_(eta(st.i)),
               title, 120);
    } catch (err) {}

    progressPut_({
      kind: st.kind, title: title, i: st.i, total: steps.length,
      label: label, elapsed: Date.now() - st.t0, eta: eta(st.i),
      took: st.took, errors: st.errors, finished: false, waiting: false,
      work: Object.keys(st.took).reduce(function (a, k) {
        return a + st.took[k]; }, 0)
    });

    // סוגרים כל כתיבה קודמת לפני שהשלב הבא מתחיל לקרוא
    try { SpreadsheetApp.flush(); } catch (e2) {}
    if ((CFG.HEAVY_STEPS || {})[label]) Utilities.sleep(2000);

    const s0 = Date.now();
    try {
      const fn = stepFns_()[steps[st.i][1]];
      if (fn) {
        const n = withRetry_(fn, 4);
        if (n > 1) st.errors.push(label + ': הצליח אחרי ' + n + ' ניסיונות');
      }
      try { SpreadsheetApp.flush(); } catch (e2) {}
    } catch (err) {
      st.errors.push(label + ': ' + err.message);
    }
    st.took[label] = Date.now() - s0;
    st.i++;

    // נשמר אחרי כל שלב. הרג באמצע עולה שלב אחד לכל היותר.
    try { saveState_(st); } catch (err) {}

    progressPut_({
      kind: st.kind, title: title, i: st.i, total: steps.length,
      label: label, elapsed: Date.now() - st.t0, eta: eta(st.i),
      took: st.took, errors: st.errors, finished: false, waiting: false,
      work: Object.keys(st.took).reduce(function (a, k) {
        return a + st.took[k]; }, 0)
    });

    // נבדק רק אחרי שהשלב כבר הסתיים — שום שלב לא נדחה מראש
    if (Date.now() - c0 > chunk) break;
  }

  // שמירת זמני השלבים לחישוב הצפי בהרצה הבאה
  try {
    Object.keys(st.took).forEach(function (k) {
      hist[k] = hist[k] ? Math.round((hist[k] + st.took[k]) / 2) : st.took[k];
    });
    PropertiesService.getDocumentProperties()
      .setProperty('STEP_TIMES', JSON.stringify(hist));
  } catch (err) {}

  if (st.i < steps.length) {
    saveState_(st);
    killContinuations_();
    ScriptApp.newTrigger(CONT_FN).timeBased().after(1000).create();
    progressPut_({
      kind: st.kind, title: title, i: st.i, total: steps.length,
      label: 'ממתין להמשך', elapsed: Date.now() - st.t0, eta: eta(st.i),
      took: st.took, errors: st.errors, finished: false, waiting: true,
      work: Object.keys(st.took).reduce(function (a, k) {
        return a + st.took[k]; }, 0)
    });
    try {
      ss.toast('הושלמו ' + st.i + ' מתוך ' + steps.length +
               '. ממשיך ברקע עוד רגע — אפשר להמשיך לעבוד.',
               title, 30);
    } catch (err) {}
    return;
  }

  finishRun_(st, steps);
}


function continueRun_() {
  killContinuations_();
  executeChunk_();
}


function finishRun_(st, steps) {
  const ss = SpreadsheetApp.getActive();
  const totalMs = Date.now() - st.t0;

  // טביעת אצבע נשמרת רק אחרי הרצה יומית נקייה ומלאה
  if (st.kind === 'daily' && st.extra && st.extra.fp && !st.errors.length) {
    try {
      PropertiesService.getDocumentProperties()
        .setProperty('DAILY_FP', st.extra.fp);
    } catch (err) {}
  }

  const slowest = Object.keys(st.took)
    .sort(function (a, b) { return st.took[b] - st.took[a]; })
    .slice(0, 5)
    .map(function (k) { return k + '  ' + Math.round(st.took[k] / 1000) + 'ש'; })
    .join('\n');

  try {
    const log = ss.getSheetByName(CFG.LOG_SHEET);
    if (log) {
      const rows = [[new Date(), st.kind === 'daily' ? 'רענון יומי' : 'הפעלה מלאה',
                     CFG.SRC, '', '', 'משך ההרצה', '',
                     fmtMMSS_(totalMs) + ' ב-' + steps.length + ' שלבים']];
      st.errors.forEach(function (msg) {
        const p = msg.split(': ');
        rows.push([new Date(), 'הרצה', p[0] || '', '', '',
                   'שגיאה', '', p.slice(1).join(': ') || msg]);
      });
      log.getRange(log.getLastRow() + 1, 1, rows.length, 8).setValues(rows);
    }
  } catch (err) {}

  clearState_();
  killContinuations_();

  progressPut_({
    kind: st.kind, title: st.kind === 'daily' ? 'רענון יומי' : 'הפעלה מלאה',
    i: steps.length, total: steps.length, label: 'הושלם',
    elapsed: totalMs, eta: 0, took: st.took, errors: st.errors,
    finished: true, waiting: false,
    work: Object.keys(st.took).reduce(function (a, k) {
      return a + st.took[k]; }, 0)
  });

  const msg = st.errors.length
    ? 'הושלם ב-' + fmtMMSS_(totalMs) + ' עם ' + st.errors.length +
      ' שגיאות:\n\n' + st.errors.join('\n')
    : 'כל ' + steps.length + ' השלבים הושלמו ב-' + fmtMMSS_(totalMs) + '.\n\n' +
      'השלבים האיטיים ביותר:\n' + slowest;

  try { ss.toast(msg, 'הושלם', 30); } catch (err) {}
}


/** עצירה ידנית של הרצה שרצה ברקע. */
/** מאפסת את מדידות זמן השלבים ששומרות את הצפי. */
function resetStepTimes() {
  if (!guard_()) return;
  try {
    PropertiesService.getDocumentProperties().deleteProperty('STEP_TIMES');
  } catch (err) {}
  const ui = SpreadsheetApp.getUi();
  ui.alert('מדידות הזמן אופסו',
    'הצפי בהרצה הבאה יחושב מחדש מאפס ויתכנס תוך כמה שלבים.',
    ui.ButtonSet.OK);
}


function stopRun() {
  if (!guard_()) return;
  const st = runState_();
  killContinuations_();
  clearState_();
  const ui = SpreadsheetApp.getUi();
  ui.alert('עצירת הרצה',
    st ? 'ההרצה נעצרה אחרי ' + st.i + ' שלבים. ' +
         'הגיליונות שכבר נבנו תקינים.'
       : 'לא רצה הרצה ברקע.', ui.ButtonSet.OK);
}


function runEverything() {
  if (!guard_()) return;
  const html = HtmlService.createHtmlOutputFromFile('RunProgress')
    .setWidth(540).setHeight(620);
  SpreadsheetApp.getUi().showModelessDialog(html, 'הפעלה מלאה');
}




/* ============================================================================
   פרק 28 — ייבוא שיוך מקובץ חיצוני
   ============================================================================
   גיליון "נתונים" מכיל רשימות עצמאיות ולא רשומות משויכות, ולכן
   אי אפשר לגזור ממנו מי המפקדת או המנה"ד של מש"קית שלא נצפתה.

   הפונקציה קוראת קובץ חיצוני שבו כל שורה היא רשומה שלמה, ומזינה
   ממנו את טבלת המיפוי. הזיהוי נעשה לפי שמות הכותרות, כך שאין
   חשיבות לסדר העמודות בקובץ שלך.

   כותרות שהיא מזהה (מספיק חלק מהן):
     מש"קית / שם המש"קית
     מספר אישי / מ.א
     מחוז
     רשות
     מפקדת
     מ.א מפקדת
     מנה"ד / מנהד אזורי

   הקובץ נשמר בזיכרון הסקריפט, כך שבפעם הבאה לא צריך להזין שוב.
   ============================================================================ */

/* קריאה בלבד. הפונקציה פותחת את קובץ השיוך, קוראת ממנו,
   וכותבת אך ורק לגיליון "מיפוי" שבקובץ הזה. אין כאן
   שום כתיבה לקובץ "כא גשרים". */
function syncRosterFromFile(silent) {
  clearMappingCache_();
  const ss = SpreadsheetApp.getActive();
  const props = PropertiesService.getDocumentProperties();
  const id = props.getProperty(CFG.ROSTER_PROP) || CFG.ROSTER_ID;

  let book;
  try { book = SpreadsheetApp.openById(id); }
  catch (err) {
    if (!silent) SpreadsheetApp.getUi().alert('לא הצלחתי לפתוח את קובץ השיוך.\n\n' +
      err.message);
    return;
  }

  // ---- עוזר: קריאת גיליון לפי שמות כותרות ----
  const readSheet = function (name, wanted) {
    const s = book.getSheetByName(name);
    if (!s || s.getLastRow() < 2) return { rows: [], idx: {} };
    const width = Math.max(s.getLastColumn(), 1);
    const hdr = s.getRange(1, 1, 1, width).getValues()[0]
      .map(function (x) { return String(x).trim(); });
    const idx = {};
    Object.keys(wanted).forEach(function (k) {
      for (let i = 0; i < hdr.length; i++) {
        if (wanted[k].indexOf(hdr[i]) !== -1) { idx[k] = i; break; }
      }
    });
    const rows = s.getRange(2, 1, s.getLastRow() - 1, width).getValues();
    return { rows: rows, idx: idx };
  };

  const val = function (r, idx, k) {
    return idx[k] === undefined ? '' : String(r[idx[k]] || '').trim();
  };

  // ---- 1. מפקדות: שם -> מספר אישי ----
  const mef = readSheet(CFG.ROSTER_MEFAKEDET, {
    name: ['שם מלא', 'מפקדת'], pid: ['מספר אישי'],
    plugah: ['פלוגה'], rashut: ['רשות']
  });
  const mefPid = {};
  mef.rows.forEach(function (r) {
    const n = val(r, mef.idx, 'name');
    const p = val(r, mef.idx, 'pid');
    if (n && p) mefPid[n] = p;
  });

  // ---- 2. רשויות: רשות -> פלוגה ----
  const ras = readSheet(CFG.ROSTER_RASHUT, {
    rashut: ['רשות'], plugah: ['פלוגה']
  });
  const rashutPlugah = {};
  ras.rows.forEach(function (r) {
    const a = val(r, ras.idx, 'rashut'), b = val(r, ras.idx, 'plugah');
    if (a && b) rashutPlugah[a] = b;
  });

  // ---- 3. משקיות: טבלת האמת ----
  const mash = readSheet(CFG.ROSTER_MASHAKIT, {
    name:    ['שם מלא', 'מש"קית', 'משקית'],
    pid:     ['מספר אישי'],
    machzor: ['מחזור'],
    rashut:  ['רשות'],
    mef:     ['מפקדת'],
    manhad:  ['מנהד', 'מנה"ד', 'מנהד אזורי'],
    plugah:  ['פלוגה']
  });
  if (mash.idx.name === undefined) {
    if (!silent) SpreadsheetApp.getUi().alert(
      'לא נמצאה עמודת "שם מלא" בגיליון "' + CFG.ROSTER_MASHAKIT + '".');
    return;
  }

  // ---- שמירת שורות שהוזנו ידנית ולא קיימות בקובץ המקור ----
  const manual = {};
  const cur = ss.getSheetByName(CFG.MAPPING_SHEET);
  if (cur && cur.getLastRow() > 1) {
    const hr = String(cur.getRange(1, 1).getValue()).trim() === MAP_HEAD[0] ? 1 : 2;
    if (cur.getLastRow() > hr) {
      cur.getRange(hr + 1, 1, cur.getLastRow() - hr, MAP_HEAD.length).getValues()
        .forEach(function (r) {
          const n = String(r[0]).trim();
          if (n) manual[n] = r;
        });
    }
  }

  const seen = {}, fromRoster = {};
  mash.rows.forEach(function (r) {
    const name = val(r, mash.idx, 'name');
    if (!name || name === '-') return;
    fromRoster[name] = true;

    const rashut = val(r, mash.idx, 'rashut');
    const mefName = val(r, mash.idx, 'mef');
    let plugah = val(r, mash.idx, 'plugah');
    if (!plugah && rashut && rashutPlugah[rashut]) plugah = rashutPlugah[rashut];

    const row = [name, val(r, mash.idx, 'pid'),
                 normMachzor_(val(r, mash.idx, 'machzor')),
                 normPlugah_(plugah), '', rashut, mefName, mefPid[mefName] || '',
                 val(r, mash.idx, 'manhad'), ''];

    const key = [row[0], row[5], row[8]].join('|');
    if (!seen[key]) seen[key] = row;
    else row.forEach(function (v, i) { if (!seen[key][i] && v) seen[key][i] = v; });
  });

  // מש"קיות שקיימות אצלנו אך לא בקובץ המקור — נשמרות עם דגל
  let orphans = 0;
  Object.keys(manual).forEach(function (n) {
    if (fromRoster[n]) return;
    const r = manual[n];
    const key = [n, String(r[5] || ''), String(r[8] || '')].join('|');
    if (!seen[key]) {
      seen[key] = [n, r[1] || '', r[2] || '', r[3] || '', r[4] || '',
                   r[5] || '', r[6] || '', r[7] || '', r[8] || '', ''];
      orphans++;
    }
  });

  // ---- חישוב "מה חסר" לכל שורה ----
  const FIELD_NAMES = [null, 'מספר אישי', 'מחזור', 'פלוגה', null,
                       'רשות', 'מפקדת', 'מ.א מפקדת', 'מנה"ד'];
  const out = Object.keys(seen).map(function (k) {
    const row = seen[k];
    const miss = [];
    [1, 2, 3, 5, 6, 7, 8].forEach(function (i) {
      if (!String(row[i] || '').trim()) miss.push(FIELD_NAMES[i]);
    });
    if (!fromRoster[row[0]]) miss.unshift('לא מופיעה בקובץ השיוך');
    row[9] = miss.length ? miss.join(', ') : '';
    return row;
  }).sort(function (a, b) {
    if (a[0] !== b[0]) return a[0] < b[0] ? -1 : 1;
    return a[5] < b[5] ? -1 : (a[5] > b[5] ? 1 : 0);
  });

  const sh = outSheet_(CFG.MAPPING_SHEET);
  ensureCols_(sh, MAP_HEAD.length + 4);
  sh.getRange(1, 1, 1, MAP_HEAD.length).setValues([MAP_HEAD]);
  if (out.length) sh.getRange(2, 1, out.length, MAP_HEAD.length).setValues(out);

  styleOutput_(sh, MAP_HEAD.length, out.length, 'כלי', [4, 5, 9]);
  sh.getRange(2, 1, Math.max(out.length, 1), MAP_HEAD.length)
    .setHorizontalAlignment('right');
  sh.setColumnWidth(10, 300);
  sh.getRange(2, 10, Math.max(out.length, 1), 1).setWrap(true);

  if (out.length) {
    const rng = sh.getRange(2, 1, out.length, MAP_HEAD.length);
    sh.setConditionalFormatRules([
      SpreadsheetApp.newConditionalFormatRule().setRanges([rng])
        .whenFormulaSatisfied('=$J2<>""').setBackground(THEME.WARN).build(),
      SpreadsheetApp.newConditionalFormatRule().setRanges([rng])
        .whenFormulaSatisfied('=COUNTIF($A$2:$A,$A2)>1')
        .setBackground(THEME.CAT_A).build()
    ]);
  }

  const names = {};
  out.forEach(function (r) { names[r[0]] = true; });
  const incomplete = out.filter(function (r) { return r[9] !== ''; }).length;

  addDescription_(sh,
    'טבלת האמת של הקובץ, מסונכרנת מ"' + book.getName() + '". ' +
    'לכל מש"קית: מספר אישי, מחזור, פלוגה, רשות, מפקדת, מ.א המפקדת והמנה"ד. ' +
    'ממנה נגזר המילוי האוטומטי בהזנת תצפית, השיוך בכל גיליונות הניהול, ' +
    'ורשימות השמות בחיפוש. ' +
    'עמודת "מה חסר" מפרטת מה עוד צריך להשלים — שורה כתומה דורשת טיפול. ' +
    'תכלת = מש"קית שמופיעה בכמה רשויות.');

  props.setProperty(CFG.ROSTER_PROP, id);

  if (!silent) {
    SpreadsheetApp.getUi().alert('הסנכרון הושלם',
      'מקור: ' + book.getName() + '\n\n' +
      Object.keys(names).length + ' מש"קיות ב-' + out.length + ' שורות.\n' +
      incomplete + ' שורות עם נתונים חסרים.\n' +
      orphans + ' מש"קיות שאינן בקובץ השיוך — נשמרו עם דגל.\n\n' +
      'הפירוט המלא בגיליון "' + CFG.GAPS_SHEET + '".',
      SpreadsheetApp.getUi().ButtonSet.OK);
  } else {
    // מתוך האתר אין ממשק גיליון — ההודעה לא חובה
    try {
      ss.toast(Object.keys(names).length + ' מש"קיות  |  ' + incomplete +
               ' עם נתונים חסרים', 'סנכרון שיוך', 12);
    } catch (err) {}
  }

  return { mashakiot: Object.keys(names).length, rows: out.length,
           incomplete: incomplete, orphans: orphans };
}


/** גרסה עם בחירת קובץ — לשינוי מקור השיוך. */
function importRosterFile() {
  if (!guard_()) return;
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getDocumentProperties();
  const saved = props.getProperty(CFG.ROSTER_PROP) || CFG.ROSTER_ID;

  const res = ui.prompt('מקור השיוך',
    'הדבק קישור לקובץ אחר, או השאר ריק כדי לסנכרן מהקובץ הנוכחי.\n\n' +
    'נוכחי: ' + saved, ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;

  const t = res.getResponseText().trim();
  if (t) {
    const m = t.match(/[-\w]{25,}/);
    props.setProperty(CFG.ROSTER_PROP, m ? m[0] : t);
  }
  syncRosterFromFile(false);
}


/* ============================================================================
   פרק 29 — הוספת עמודות פלוגה ומחזור לגיליון הראשי
   ============================================================================
   מוסיפה את שתי העמודות מיד אחרי "רשות", אם הן לא קיימות.

   נקודה טכנית שחייבת טיפול: הנוסחה בגיליון "עזר_שיעורים" מפנה
   לעמודת "שם השיפט" באות קבועה בתוך INDIRECT, ולכן היא לא מתעדכנת
   לבד כשמוסיפים עמודות לפניה. הפונקציה מזהה את המיקום החדש
   ומתקנת את הנוסחה — אחרת הרשימה הנפתחת של השיעורים נשברת.
   ============================================================================ */

/* ============================================================================
   פרק 45 — סידור עמודות הזיהוי
   ============================================================================
   המש"קית היא הנתון הראשון שנבחר, ואחריה הכול מושלם לבד.
   לכן מקומה בתחילת הטבלה.

   הזזת עמודה שוברת כל הפניה לאות עמודה קבועה, ולכן אחרי
   ההזזה רצה שרשרת התיקון המלאה.
   ============================================================================ */

function arrangeColumns() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const ui = SpreadsheetApp.getUi();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא גיליון ההזנה'); return; }

  const PLAN = CFG.COLUMN_PLAN || [];
  if (!PLAN.length) { ss.toast('לא הוגדרה תוכנית עמודות'); return; }

  /** המיקום הסופי הרצוי לכלל, או 0 אם אין מה לעשות. */
  const wanted = function (rule, m) {
    const from = findCol_(m, rule.col) + 1;
    if (from < 1) return { from: 0, to: 0 };

    if (rule.at) return { from: from, to: rule.at };

    if (rule.before) {
      const anchor = findCol_(m, rule.before) + 1;
      if (anchor < 1) return { from: 0, to: 0 };
      // מיד לפני העוגן, בשני הכיוונים
      const to = from > anchor ? anchor : anchor - 1;
      return { from: from, to: to };
    }
    return { from: 0, to: 0 };
  };

  let m = colMap_(sh);
  const before = PLAN.map(function (p) {
    const i = findCol_(m, p.col);
    return p.col + ': ' + (i < 0 ? 'לא נמצאה' : colLetter_(i));
  });

  const pending = PLAN.filter(function (p) {
    const w = wanted(p, m);
    return w.from && w.from !== w.to;
  });

  if (!pending.length) {
    ui.alert('סידור עמודות', 'כל העמודות כבר במקומן.', ui.ButtonSet.OK);
    return;
  }

  const res = ui.alert('סידור עמודות',
    'מיקום נוכחי:\n' + before.join('\n') + '\n\n' +
    'התוכנית:\n' + PLAN.map(function (p) {
      return p.col + ' -> ' + (p.at ? 'עמודה ' + colLetter_(p.at - 1)
                                    : 'מיד לפני "' + p.before + '"');
    }).join('\n') + '\n\n' +
    'אחרי ההזזה ייבנו מחדש: נוסחת הציון, אימותי הנתונים, ' +
    'רשימות השיעורים והמתצפתים ונוסחאות השליפה.\n\nלהמשיך?',
    ui.ButtonSet.YES_NO);
  if (res !== ui.Button.YES) return;

  /* ---------- ההזזה ---------- */
  const moved = [];
  PLAN.forEach(function (p) {
    m = colMap_(sh);                      // נקרא מחדש אחרי כל הזזה
    const w = wanted(p, m);
    if (!w.from || w.from === w.to) return;

    try {
      // destinationIndex מתייחס לקואורדינטות שלפני ההזזה
      const dest = w.from < w.to ? w.to + 1 : w.to;
      sh.moveColumns(sh.getRange(1, w.from, sh.getMaxRows(), 1), dest);
      SpreadsheetApp.flush();
      moved.push(p.col + ': ' + colLetter_(w.from - 1) +
                 ' -> ' + colLetter_(w.to - 1));
    } catch (err) {
      moved.push(p.col + ': נכשל — ' + err.message);
    }
  });

  clearObsCache_();
  SpreadsheetApp.flush();

  /* ---------- שרשרת התיקון ---------- */
  const errors = [];
  const step = function (name, fn) {
    try { fn(); } catch (err) { errors.push(name + ': ' + err.message); }
  };

  step('נוסחת הציון',        restoreScoreFormula);
  step('אימותי נתונים',      repairValidations);
  step('רשימות שיעורים',     syncLessonValidation);
  step('רשימות מתצפתים',     syncObserverValidation);
  step('נוסחאות שליפה',      installLookupFormulas);

  m = colMap_(sh);
  const after = PLAN.map(function (p) {
    const i = findCol_(m, p.col);
    return p.col + ': ' + (i < 0 ? 'לא נמצאה' : colLetter_(i));
  });

  ui.alert('סידור עמודות',
    'הוזז:\n' + (moved.length ? moved.join('\n') : 'שום דבר') + '\n\n' +
    'מיקום סופי:\n' + after.join('\n') + '\n\n' +
    (errors.length
      ? 'שגיאות בשרשרת התיקון:\n' + errors.join('\n')
      : 'כל התיקונים עברו בהצלחה.') + '\n\n' +
    'נותר להריץ "הגדר הרשאות" כדי לבנות מחדש את טווחי הנעילה.',
    ui.ButtonSet.OK);
}


function ensureMainColumns() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא הגיליון ' + CFG.SRC); return; }

  const WANT = ['פלוגה', 'מחזור'];
  let added = [];

  WANT.forEach(function (title) {
    const m = colMap_(sh);
    if (findCol_(m, title) >= 0) return;
    const after = findCol_(m, 'רשות');
    if (after < 0) return;

    sh.insertColumnAfter(after + 1);
    const col = after + 2;

    // עמודה חדשה יורשת את האימות והעיצוב מהעמודה שמשמאלה.
    // בלי הניקוי הזה, "פלוגה" הייתה מקבלת את רשימת הרשויות.
    sh.getRange(1, col, sh.getMaxRows(), 1)
      .clearDataValidations().clearContent().clearFormat();

    sh.getRange(CFG.HEADER_ROW, col).setValue(title)
      .setBackground(THEME.HEAD_BG).setFontColor(THEME.INK_STRONG)
      .setFontSize(10).setFontWeight('bold').setWrap(true)
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
    sh.setColumnWidth(col, 110);
    added.push(title);
  });

  // מתקנים את נוסחת העזר רק אם באמת הוזזו עמודות —
  // אחרת אין סיבה לדרוס נוסחה קיימת שאולי הותאמה ידנית
  if (added.length) fixHelperFormula_();

  ss.toast(added.length ? 'נוספו עמודות: ' + added.join(', ') +
                          '  |  נוסחת עזר_שיעורים יושרה'
                        : 'העמודות כבר קיימות', 'מבנה הגיליון', 12);
}


/**
 * מיישרת את הנוסחה בעזר_שיעורים למיקום הנוכחי של "שם השיפט".
 */
function fixHelperFormula_() {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  const helper = ss.getSheetByName(CFG.HELPER_SHEET);
  if (!sh || !helper) return;

  const letter = colLetter_(findCol_(colMap_(sh), 'שם השיפט'));
  if (!letter) return;

  // גבול הטווח ב"נתונים": הרוחב האמיתי ועוד עשר עמודות
  // מילואים. הגרסה הקודמת סרקה עד AAE — 729 עמודות —
  // בכל אחת מכ-500 השורות.
  const data = ss.getSheetByName(CFG.DATA_SHEET);
  const dCols = data ? Math.min(Math.max(data.getLastColumn(), 1) + 10, 120) : 60;
  const dLet = colLetter_(dCols - 1);

  // INDEX ולא INDIRECT.
  //
  // INDIRECT תנודתית: היא מחושבת מחדש בכל שינוי בכל מקום
  // בקובץ, ו-500 נוסחאות כאלה משתקות אותו למי שיושב על
  // חיבור איטי. INDEX נותנת בדיוק את אותה התנהגות —
  // יישור לפי מספר השורה, ועמידות בהוספת שורות כי זו
  // הפניה לעמודה שלמה — אבל היא לא תנודתית.
  const SRCQ = "'" + CFG.SRC + "'!";
  const f = '=LET(' +
    'k, INDEX(' + SRCQ + '$' + letter + ':$' + letter + ', ROW()), ' +
    'IF(k="", "", LET(' +
    'col, INDEX(\'נתונים\'!$A$2:$' + dLet + ', , ' +
    'MATCH(TRIM(CLEAN(k)), ' +
    'TRIM(CLEAN(\'נתונים\'!$A$1:$' + dLet + '$1)), 0)), ' +
    'TRANSPOSE(FILTER(col, col<>"")))))';

  const last = Math.max(helper.getLastRow(), sh.getMaxRows());
  ensureRows_(helper, last);
  const n = last - CFG.FIRST_ROW + 1;
  if (n < 1) return;

  const arr = [];
  for (let i = 0; i < n; i++) arr.push([f]);
  helper.getRange(CFG.FIRST_ROW, 1, n, 1).setFormulas(arr);
}



/* ============================================================================
   פרק 30 — השלמות נדרשות
   ============================================================================
   רשימה אחת שאומרת בדיוק איזה נתון חסר ולמי. נבנית משני מקורות:
   טבלת המיפוי (מי חסר שיוך) והתצפיות עצמן (מי לא מופיעה במיפוי).
   ============================================================================ */

function buildDataGapsSheet() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const mapping = getMapping_();
  const o = getObservations_();
  const c = o.c;

  const out = [];

  // 1. שורות מיפוי עם שדות חסרים
  const sh0 = ss.getSheetByName(CFG.MAPPING_SHEET);
  if (sh0 && sh0.getLastRow() > 1) {
    const hr = String(sh0.getRange(1, 1).getValue()).trim() === MAP_HEAD[0] ? 1 : 2;
    if (sh0.getLastRow() > hr) {
      sh0.getRange(hr + 1, 1, sh0.getLastRow() - hr, MAP_HEAD.length).getValues()
        .forEach(function (r) {
          const name = String(r[0]).trim();
          const miss = String(r[9] || '').trim();
          if (!name || !miss) return;
          out.push(['1. שיוך חסר', name, String(r[5] || ''), String(r[6] || ''),
                    String(r[8] || ''), miss,
                    'להשלים בקובץ "כא גשרים" ואז לסנכרן מחדש']);
        });
    }
  }

  // 2. מש"קיות שנצפו אך אינן במיפוי כלל
  const missing = {};
  o.rows.forEach(function (r) {
    const k = String(r[c.mashakit]).trim();
    if (k && !mapping[k]) missing[k] = (missing[k] || 0) + 1;
  });
  Object.keys(missing).forEach(function (k) {
    out.push(['2. לא במיפוי', k, '', '', '',
              'נצפתה ' + missing[k] + ' פעמים אך אינה בטבלת המיפוי',
              'לבדוק אם השם כתוב אחרת בקובץ השיוך']);
  });

  // 3. מש"קיות במיפוי שמעולם לא נצפו
  const seen = {};
  o.rows.forEach(function (r) {
    const k = String(r[c.mashakit]).trim();
    if (k) seen[k] = true;
  });
  Object.keys(mapping).forEach(function (k) {
    if (seen[k]) return;
    const mp = mapping[k];
    out.push(['3. טרם נצפתה', k, showAll_(mp.rashut), only_(mp.mef),
              showAll_(mp.manhad), 'אין עליה אף תצפית',
              'לתאם תצפית ראשונה']);
  });

  out.sort(function (a, b) {
    if (a[0] !== b[0]) return a[0] < b[0] ? -1 : 1;
    return a[1] < b[1] ? -1 : 1;
  });

  const head = ['סוג החוסר', 'מש"קית', 'רשות', 'מפקדת', 'מנה"ד',
                'מה חסר', 'מה לעשות'];
  const sh = outSheet_(CFG.GAPS_SHEET);
  ensureCols_(sh, head.length + 4);
  sh.getRange(1, 1, 1, head.length).setValues([head]);
  if (out.length) sh.getRange(2, 1, out.length, head.length).setValues(out);

  styleOutput_(sh, head.length, out.length, 'ניהול', [1, 5]);
  sh.setColumnWidth(6, 320);
  sh.setColumnWidth(7, 280);
  sh.getRange(2, 6, Math.max(out.length, 1), 2)
    .setHorizontalAlignment('right').setWrap(true);

  if (out.length) {
    const rng = sh.getRange(2, 1, out.length, head.length);
    sh.setConditionalFormatRules([
      SpreadsheetApp.newConditionalFormatRule().setRanges([rng])
        .whenFormulaSatisfied('=$A2="1. שיוך חסר"').setBackground(THEME.BAD).build(),
      SpreadsheetApp.newConditionalFormatRule().setRanges([rng])
        .whenFormulaSatisfied('=$A2="2. לא במיפוי"').setBackground(THEME.WARN).build()
    ]);
  }

  addDescription_(sh,
    'רשימת ההשלמות: מה חסר, למי, ומה לעשות עם זה. ' +
    'שיוך חסר = מש"קית שרשומה במיפוי אך חסרים לה פרטים (מפקדת, פלוגה, מחזור וכו"). ' +
    'לא במיפוי = בוצעו עליה תצפיות אבל היא לא קיימת בקובץ השיוך — כנראה הבדל בכתיב השם. ' +
    'טרם נצפתה = קיימת במיפוי אך אין עליה אף תצפית. ' +
    'את התיקונים עושים בקובץ "כא גשרים" ואז מריצים סנכרון מחדש.');

  ss.toast(out.length + ' פריטים דורשים השלמה', CFG.GAPS_SHEET, 12);
}


/* ============================================================================
   פרק 31 — תיקון כל הרשימות הנפתחות
   ============================================================================
   הוספת עמודות באמצע הגיליון גורמת לשתי תקלות:

     1. עמודה חדשה יורשת את האימות מהעמודה שמשמאלה. כך "פלוגה"
        קיבלה את רשימת הרשויות ו"מחזור" קיבלה אותה אחריה.
     2. כל העמודות שאחרי נקודת ההוספה זזו, ואימותים שמפנים
        לטווחים מוחלטים — רשימת השיעורים ורשימת המתצפתים —
        הצביעו על המקום הישן.

   הפונקציה מנקה את האימותים בכל עמודות הבחירה ובונה את כולם
   מחדש לפי שמות הכותרות, כך שאין חשיבות למיקום העמודה.
   ============================================================================ */

function repairValidations() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא הגיליון ' + CFG.SRC); return; }

  const m = colMap_(sh);
  const n = sh.getMaxRows() - CFG.FIRST_ROW + 1;

  // כל העמודות שאמורות להכיל רשימה נפתחת
  const TITLES = ['מחוז', 'פלוגה', 'מחזור', 'רשות', 'מנהד אזורי', 'מפקדת',
                  'משקית', 'מש"קית מתגברת', 'שם השיפט', 'שם ומספר שיעור',
                  'תפקיד המתצפת', 'שם המתצפת', 'תפקוד המתגברת', 'הועבר משוב']
    .concat(CFG.CRITERIA.map(function (x) { return x[0]; }));

  let cleared = 0;
  TITLES.forEach(function (t) {
    const i = findCol_(m, t);
    if (i < 0) return;
    sh.getRange(CFG.FIRST_ROW, i + 1, n, 1).clearDataValidations();
    cleared++;
  });

  // בנייה מחדש — הכול לפי שם הכותרת
  restoreDropdowns();
  restoreScoreDropdowns();
  syncLessonValidation();
  syncObserverValidation();

  // applyCategoryColors לא נקראת כאן יותר — היא כותבת עיצוב
  // מותנה לגיליון ההזנה, והוא לא מעוצב מחדש אוטומטית.
  // העיצוב המותנה הקיים לא נפגע מבניית הרשימות מחדש.

  ss.toast('נוקו ונבנו מחדש ' + cleared + ' עמודות בחירה',
           'תיקון רשימות', 12);
}


/* ============================================================================
   פרק 32 — שחזור נוסחת ציון התצפית
   ============================================================================
   הנוסחה נבנית מחדש לפי המיקום הנוכחי של ששת הקריטריונים
   ולפי המשקלות שב-CFG.CRITERIA, כך שהיא תקינה גם אחרי שהוזזו
   עמודות ואין בה אותיות קבועות.

   היא מפנה לששת תאי הקריטריון בשמם ולא לטווח רציף — כך
   עמודות ה"פירוט" שביניהם לא נכנסות לחישוב.

   מה הנוסחה עושה:
     אם לא מולא אף קריטריון  ->  ריק
     אם יש מקף באחד מהם       ->  "חסר ציון"
     אחרת                     ->  ממוצע משוקלל כפול 100
   ============================================================================ */

function restoreScoreFormula() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא הגיליון ' + CFG.SRC); return; }

  const m = colMap_(sh);
  const scoreIdx = findCol_(m, 'ציון תצפית');
  if (scoreIdx < 0) { ss.toast('לא נמצאה עמודת "ציון תצפית"'); return; }

  const letters = [], weights = [];
  for (let i = 0; i < CFG.CRITERIA.length; i++) {
    const idx = findCol_(m, CFG.CRITERIA[i][0]);
    if (idx < 0) {
      ss.toast('לא נמצאה עמודת "' + CFG.CRITERIA[i][0] + '"', 'שגיאה', 15);
      return;
    }
    letters.push(colLetter_(idx));
    weights.push(CFG.CRITERIA[i][1]);
  }

  const lastRow = sh.getMaxRows();
  const n = lastRow - CFG.FIRST_ROW + 1;
  if (n < 1) return;

  const build = function (row) {
    const cells = letters.map(function (L) { return L + row; });
    const weighted = cells.map(function (cell, i) {
      return '(' + cell + '/5)*' + weights[i];
    }).join(' + ');
    const dash = cells.map(function (cell) {
      return cell + '="-"';
    }).join(', ');
    return '=IF(COUNT(' + cells.join(',') + ')=0, "", ' +
           'IF(OR(' + dash + '), "חסר ציון", ' +
           'ROUND((' + weighted + ') * 100, 0)))';
  };

  const arr = [];
  for (let r = CFG.FIRST_ROW; r <= lastRow; r++) arr.push([build(r)]);
  sh.getRange(CFG.FIRST_ROW, scoreIdx + 1, n, 1).setFormulas(arr);
  sh.getRange(CFG.FIRST_ROW, scoreIdx + 1, n, 1).setNumberFormat('0');

  ss.toast('נוסחת הציון שוחזרה בעמודה ' + colLetter_(scoreIdx) +
           ' לאורך ' + n + ' שורות', 'ציון תצפית', 12);
}
