  // מחיקת שורה היא שינוי מבנה שמשודר לכל מי שהקובץ פתוח
  // אצלו. בלי המרווח, כל עריכה בודדת גררה מחיקה, כלומר
  // סנכרון מאולץ אצל כל שאר המשתמשים.
  LOG_MAX: 2000,
  LOG_SLACK: 250,

  // true = גם מילוי של תא ריק נרשם ביומן השינויים.
  // ראה את ההסבר בראש הקובץ לפני שמדליקים.
  LOG_NEW_VALUES: false,

  // ----- הרשאות ניהול -----
  // מי רואה את תפריט "כלי תצפיות" המלא בלי סיסמה.
  ADMIN_EMAILS: [
    'almogt@cyber.org.il',
    'ShiriKle@cyber.org.il'
  ],
  ADMIN_PASS_PROP: 'ADMIN_PASS',     // הסיסמה נשמרת כאן, לא בקוד
  UNLOCK_PROP: 'TOOLS_UNLOCKED',

