}


function applyCategoryColors() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא הגיליון'); return; }

  const m = colMap_(sh);
  const SCHEME = {};
  CFG.CRITERIA.forEach(function (x) {
    const i = findCol_(m, x[0]);
    if (i >= 0) SCHEME[i + 1] = [
      [5, THEME.S5], [4, THEME.S4], [3, THEME.S3],
      [2, THEME.S2], [1, THEME.S1], ['-', THEME.NA]];
  });
  const iSup = findCol_(m, 'תפקוד המתגברת');
  if (iSup >= 0) SCHEME[iSup + 1] = [
    ['מעולה', THEME.S5], ['טוב', THEME.S4], ['בינוני', THEME.S3],
    ['נמוך', THEME.S1], ['אין מתגברת', THEME.NA]];
  const iFb = findCol_(m, 'הועבר משוב');
  if (iFb >= 0) SCHEME[iFb + 1] = [
    ['כן', THEME.S5], ['בהמשך', THEME.S3], ['אחר', THEME.NA], ['לא', THEME.S1]];

  const targets = Object.keys(SCHEME).map(Number);
  const lastRow = sh.getMaxRows();
  const n = lastRow - CFG.FIRST_ROW + 1;

  const kept = sh.getConditionalFormatRules().filter(function (rule) {
    const mine = rule.getRanges().every(function (r) {
      return r.getNumColumns() === 1 &&
             targets.indexOf(r.getColumn()) !== -1 && r.getRow() === CFG.FIRST_ROW;
    });
    return !mine;
  });

  const added = [];
  targets.forEach(function (col) {
    const rng = sh.getRange(CFG.FIRST_ROW, col, n, 1);
    SCHEME[col].forEach(function (pair) {
      const b = SpreadsheetApp.newConditionalFormatRule().setRanges([rng]);
      added.push(typeof pair[0] === 'number'
        ? b.whenNumberEqualTo(pair[0]).setBackground(pair[1]).build()
        : b.whenTextEqualTo(pair[0]).setBackground(pair[1]).build());
    });
  });
  sh.setConditionalFormatRules(kept.concat(added));
  ss.toast('נוספו ' + added.length + ' כללי צבע', 'הושלם', 6);
}


function applyMainSheetTheme() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא הגיליון ' + CFG.SRC); return; }

  const lastCol = sh.getLastColumn();
  sh.setTabColor(TABS['מקור']);

  const CAT_COLORS = {
    'מידע': THEME.CAT_INFO, 'הוראת תוכן': THEME.CAT_A,
    'הדרכה ותקשורת': THEME.CAT_B, 'ניהול כיתה': THEME.CAT_C,
    'נתונים לאחר': THEME.CAT_INFO };
  const CAT_INK = {
    'מידע': THEME.INK_STRONG, 'הוראת תוכן': '#1565C0',
    'הדרכה ותקשורת': '#0D47A1', 'ניהול כיתה': '#0D47A1',
    'נתונים לאחר': THEME.INK_STRONG };

  sh.getRange(2, 1, 1, lastCol).getMergedRanges().forEach(function (mr) {
    const txt = String(mr.getCell(1, 1).getValue()).trim();
    let hit = null;
    Object.keys(CAT_COLORS).forEach(function (k) { if (txt.indexOf(k) > -1) hit = k; });
    if (!hit) return;
    mr.setBackground(CAT_COLORS[hit]).setFontColor(CAT_INK[hit])
      .setFontSize(11).setFontWeight('bold').setFontLine('none')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
  });
  sh.setRowHeight(2, 32);

  sh.getRange(3, 1, 1, lastCol).setBackground('#FAFAFA').setFontColor('#90A4AE')
    .setFontSize(9).setFontWeight('normal').setHorizontalAlignment('center');
  sh.setRowHeight(3, 20);

  sh.getRange(CFG.HEADER_ROW, 1, 1, lastCol)
    .setBackground(THEME.HEAD_BG).setFontColor(THEME.INK_STRONG)
    .setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true)
    .setBorder(null, null, true, null, null, null,
               THEME.FRAME, SpreadsheetApp.BorderStyle.SOLID_THICK);

  const lastRow = Math.max(lastDataRow_(sh, findCol_(colMap_(sh), 'תאריך')), CFG.FIRST_ROW);
  sh.getRange(CFG.FIRST_ROW, 1, lastRow - CFG.FIRST_ROW + 1, lastCol)
    .setFontColor(THEME.INK).setFontSize(10)
    .setVerticalAlignment('middle')
    .setBorder(null, null, null, null, true, true,
               THEME.GRID, SpreadsheetApp.BorderStyle.SOLID);

  sh.setFrozenRows(CFG.HEADER_ROW);
  sh.setFrozenColumns(4);

  const m = colMap_(sh);
  Object.keys(m).forEach(function (k) {
    if (k.indexOf('פירוט') === 0) sh.setColumnWidth(m[k] + 1, 200);
  });

  // קווים עבים בין קבוצות העמודות
  [findCol_(m, 'תאריך'), findCol_(m, 'ציון תצפית')].forEach(function (i) {
    if (i < 0) return;
    sh.getRange(CFG.HEADER_ROW, i + 1, lastRow - CFG.HEADER_ROW + 1, 1)
      .setBorder(null, true, null, null, null, null,
                 THEME.FRAME, SpreadsheetApp.BorderStyle.SOLID_MEDIUM);
  });

  let spill = -1;
  Object.keys(m).forEach(function (k) {
    if (/^נתונים\s+\d+$/.test(k) && (spill < 0 || m[k] < spill)) spill = m[k];
  });
  if (spill > 0 && lastCol > spill) sh.hideColumns(spill + 1, lastCol - spill);

  ss.toast('העיצוב הוחל על הגיליון הראשי', 'הושלם', 8);
}


/**
 * שיפור עיצוב גורף לכל הגיליונות הטבלאיים.
 */
function beautifyAllSheets() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  // CFG.SRC — גיליון ההזנה. המשתמש מעצב אותו ידנית,
  // והסקריפט לא נוגע בעיצוב שלו לעולם.
  // גיליונות בפריסה ידנית — כותרת, רצועת מדדים וכמה
  // טבלאות. עיצוב גורף הורס אותם.
  const SKIP = [CFG.SRC, 'מסך בית', 'דשבורד', CFG.CARD_SHEET, CFG.HELPER_SHEET,
                CFG.TREND_SHEET, CFG.NATIONAL_SHEET, CFG.MADMACH_SHEET,
                CFG.SCHOOLS_HELPER].concat(CFG.MANUAL_SHEETS || []);
  let n = 0;

  ss.getSheets().forEach(function (sh) {
    const name = sh.getName();
    try {
      if (SKIP.indexOf(name) !== -1) {
        sh.setRightToLeft(true);
        sh.setHiddenGridlines(true);
        return;
      }
      const lastRow = sh.getLastRow(), lastCol = sh.getLastColumn();
      if (lastRow < 1 || lastCol < 1) return;

      sh.setRightToLeft(true);
      sh.setHiddenGridlines(true);

      sh.getRange(1, 1, 1, lastCol)
        .setBackground(THEME.HEAD_BG).setFontColor(THEME.INK_STRONG)
        .setFontFamily('Arial').setFontSize(11).setFontWeight('bold')
        .setFontLine('none').setWrap(true)
        .setHorizontalAlignment('center').setVerticalAlignment('middle');
      sh.setRowHeight(1, 54);

      const rows = lastRow - 1;
      if (rows > 0) {
        const body = sh.getRange(2, 1, rows, lastCol);
        body.setFontFamily('Arial').setFontSize(11).setFontColor(THEME.INK)
            .setFontWeight('normal')
            .setHorizontalAlignment('center').setVerticalAlignment('middle');
        sh.getRange(2, 1, rows, 1).setHorizontalAlignment('right')
          .setFontWeight('bold').setFontColor(THEME.INK_STRONG);
        sh.setRowHeights(2, rows, 28);
      }

      frameTable_(sh, 1, 1, lastRow, lastCol, []);

      sh.autoResizeColumns(1, lastCol);
      for (let i = 1; i <= lastCol; i++) {
        const w = sh.getColumnWidth(i);
        if (w < 95) sh.setColumnWidth(i, 95);
        if (w > 300) sh.setColumnWidth(i, 300);
      }
      sh.setColumnWidth(1, 185);
      sh.setFrozenRows(1);
      sh.setFrozenColumns(1);
      n++;
    } catch (err) {}
  });

  ss.toast('עוצבו ' + n + ' גיליונות', 'שיפור עיצוב', 12);
}



/* ============================================================================
   פרק 20 — תחזוקה והגנה
   ============================================================================ */

function topUpRowPool() {
  if (!guard_()) return;
  clearObsCache_();
  const MIN_FREE = 300, BATCH = 500;
  const sh = SpreadsheetApp.getActive().getSheetByName(CFG.SRC);
  if (!sh) return;

  const n = sh.getMaxRows() - CFG.FIRST_ROW + 1;
  const vals = sh.getRange(CFG.FIRST_ROW, 2, n, 1).getValues();
  const free = vals.filter(function (r) { return r[0] !== true; }).length;
  if (free >= MIN_FREE) return;

  const last = sh.getMaxRows();
  const width = sh.getLastColumn();
  sh.insertRowsAfter(last, BATCH);
  sh.getRange(last, 1, 1, width).copyTo(
    sh.getRange(last + 1, 1, BATCH, width),
    SpreadsheetApp.CopyPasteType.PASTE_NORMAL, false);
  sh.getRange(last + 1, 1, BATCH, width).clearContent();
}


/**
 * נעילה מלאה.
 *
 * פתוח למשתמשים: רק אזור ההזנה בגיליון הראשי, תיבת החיפוש
 * במסך הבית. כל השאר נעול — כולל המיפוי,
 * הנתונים, כל גיליונות הניתוח והיומן.
 *
 * צעד ידני חובה: שיתוף > גלגל שיניים >
 * ביטול "עורכים רשאים לשנות הרשאות ולשתף".
 */
function setupProtection() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { ss.toast('לא נמצא הגיליון ' + CFG.SRC); return; }
  // כל מי שב-CFG.ADMIN_EMAILS, ועוד מי שמריץ עכשיו.
  //
  // הגרסה הקודמת השאירה רק את מי שהריץ ומחקה את כל השאר,
  // ולכן כל רענון היה מוציא את המנהל השני מכל הגיליונות
  // המוגנים. עכשיו נמחק רק מי שאיננו ברשימה.
  const admins = {};
  (CFG.ADMIN_EMAILS || []).forEach(function (x) {
    const e = String(x || '').trim().toLowerCase();
    if (e) admins[e] = true;
  });
  const me = Session.getEffectiveUser().getEmail();
  if (me) admins[String(me).trim().toLowerCase()] = true;
  const keep = Object.keys(admins);

  const lockdown = function (s, desc) {
    s.getProtections(SpreadsheetApp.ProtectionType.SHEET)
      .forEach(function (p) { p.remove(); });
    const p = s.protect().setDescription(desc);

    keep.forEach(function (e) {
      // נכשל אם אין לה בכלל גישה לקובץ — שיתוף ב-Drive
      // הוא תנאי מוקדם ולא משהו שהקוד יכול לעשות.
      try { p.addEditor(e); } catch (err) {}
    });

    p.getEditors().forEach(function (u) {
      const e = String(u.getEmail() || '').trim().toLowerCase();
      if (!e || admins[e]) return;
      try { p.removeEditor(u); } catch (err) {}   // בעל הקובץ אינו ניתן להסרה
    });

    if (p.canDomainEdit()) p.setDomainEdit(false);
    return p;
  };

  const m = colMap_(sh);
  const scoreIdx = findCol_(m, 'ציון תצפית');
  let spillIdx = -1;
  Object.keys(m).forEach(function (k) {
    if (/^נתונים\s+\d+$/.test(k) && (spillIdx < 0 || m[k] < spillIdx)) spillIdx = m[k];
  });
  const lastOpenIdx = (spillIdx > 0 ? spillIdx - 1 : sh.getLastColumn() - 1);

  // עמודת הציון נעולה תמיד — היא נוסחה מחושבת.
  // עמודות השליפה נעולות רק אם CFG.LOCK_LOOKUP_COLS.
  const locked = {};
  if (scoreIdx >= 0) locked[scoreIdx] = true;
  if (CFG.LOCK_LOOKUP_COLS) {
    (CFG.LOOKUP_COLS || []).forEach(function (t) {
      const i = findCol_(m, t);
      if (i >= 0) locked[i] = true;
    });
  }

  // בונים את רשימת העמודות הפתוחות ומאחדים לטווחים רציפים
  const open = [];
  let runStart = -1;
  for (let i = 1; i <= lastOpenIdx + 1; i++) {
    const isOpen = i <= lastOpenIdx && !locked[i];
    if (isOpen && runStart < 0) runStart = i;
    if (!isOpen && runStart >= 0) {
      open.push(colLetter_(runStart) + CFG.FIRST_ROW + ':' + colLetter_(i - 1));
      runStart = -1;
    }
  }

  const prot = lockdown(sh, 'ניטור תצפיות - הזנה בלבד');
  prot.setUnprotectedRanges(open.map(function (a) { return sh.getRange(a); }));

  let others = 0;
  ss.getSheets().forEach(function (s) {
    if (s.getName() === CFG.SRC) return;
    const p = lockdown(s, 'נעול - ' + s.getName());
    if (s.getName() === CFG.CARD_SHEET) {
      p.setUnprotectedRanges([s.getRange('B2:C2')]);
    } else if (s.getName() === 'מסך בית') {
      p.setUnprotectedRanges([s.getRange('B11:C11')]);
    }
    others++;
  });

  ss.toast('פתוח: ' + open.join(', ') + '  |  ' + others + ' גיליונות ננעלו',
           'ההגנה הוגדרה', 15);
}



