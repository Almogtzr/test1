/* ============================================================================
   פרק 24 — התקנת הטריגר היומי
   ============================================================================
   מותקן טריגר אחד בלבד:

       refreshEverything   כל יום ב-05:00   מרענן את כל הגיליונות

   כל שאר הטריגרים מוסרים.

   חשוב לדעת מה מפסיק לעבוד בלי onEditInstalled:

     1. המילוי האוטומטי מטבלת המיפוי.
        בחירת מש"קית כבר לא תמלא לבד רשות, מפקדת, מנה"ד,
        פלוגה ומחזור. צריך למלא ידנית, או להריץ
        "השלם שדות בכל השורות" מהתפריט.

     2. יומן השינויים יישאר ריק.

   ובלי onStructureChange: רשימות השיעורים והמתצפתים לא
   יסתנכרנו לבד כשמוסיפים או מוחקים שורה. "תיקון מהיר"
   מהתפריט עושה את זה בלחיצה.

   להחזרת ההתנהגות המלאה — CFG.FULL_TRIGGERS: true
   ============================================================================ */

function installAllTriggers() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const ui = SpreadsheetApp.getUi();
  const id = ss.getId();

  // ---- 1. מיפוי הקיים ----
  let removed = 0;
  const foreign = [];

  ScriptApp.getProjectTriggers().forEach(function (t) {
    const fn = t.getHandlerFunction();
    if (CFG.MY_TRIGGERS.indexOf(fn) !== -1) {
      ScriptApp.deleteTrigger(t);
      removed++;
    } else {
      foreign.push(t);
    }
  });

  // ---- 2. טריגרים של תוספים אחרים — שואלים לפני ----
  let removedForeign = 0;
  if (foreign.length) {
    const names = foreign.map(function (t) { return t.getHandlerFunction(); });
    const res = ui.alert('טריגרים שאינם מהקוד הזה',
      'נמצאו ' + foreign.length + ' טריגרים שלא שייכים לקוד הניטור:\n\n' +
      names.join('\n') + '\n\n' +
      'למחוק גם אותם?\n\n' +
      'מחיקה משביתה את מה שהם מפעילים.',
      ui.ButtonSet.YES_NO);

    if (res === ui.Button.YES) {
      foreign.forEach(function (t) { ScriptApp.deleteTrigger(t); removedForeign++; });
    }
  }

  // ---- 3. התקנה ----
  const made = [];

  const T = CFG.TRIGGERS || {};

  if (T.daily) {
    ScriptApp.newTrigger('refreshEverything').timeBased()
      .everyDays(1).atHour(5).create();
    made.push('refreshEverything  —  כל יום ב-05:00');
  }

  if (T.edit) {
    ScriptApp.newTrigger('onEditInstalled').forSpreadsheet(id).onEdit().create();
    made.push('onEditInstalled  —  בכל עריכה (יומן + מילוי אוטומטי)');
  }

  if (T.structure) {
    ScriptApp.newTrigger('onStructureChange').forSpreadsheet(id).onChange().create();
    made.push('onStructureChange  —  בעת שינוי מבנה');
  }

  if (T.weekly) {
    ScriptApp.newTrigger('topUpRowPool').timeBased()
      .onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(2).create();
    made.push('topUpRowPool  —  ראשון 02:00');
  }

  if (T.monthly) {
    ScriptApp.newTrigger('buildMonthlySnapshot').timeBased()
      .onMonthDay(1).atHour(3).create();
    made.push('buildMonthlySnapshot  —  1 בחודש 03:00');
  }

  // ---- 4. דוח ----
  let msg = 'הוסרו ' + removed + ' טריגרים של הניטור';
  if (removedForeign) msg += ' ועוד ' + removedForeign + ' של תוספים';
  else if (foreign.length) msg += '.\nנשמרו ' + foreign.length + ' טריגרים של תוספים';
  msg += '.\n\nמותקן עכשיו:\n\n' + made.join('\n');

  if (!(CFG.TRIGGERS || {}).edit) {
    msg += '\n\nבלי טריגר העריכה: המילוי האוטומטי בבחירת מש"קית ' +
           'ויומן השינויים לא פעילים. "תיקון מהיר" מהתפריט ממלא ' +
           'את השדות בכל השורות בלחיצה.';
  }

  try { ui.alert('טריגרים', msg, ui.ButtonSet.OK); }
  catch (err) { ss.toast(msg, 'טריגרים', 30); }
}



/* ============================================================================
   פרק 25 — תיקון נתונים שהוזזו
   ============================================================================
   הבאג של הזזת העמודות במיפוי זיהם גם את גיליון הניטור: המילוי
   האוטומטי דחף ערכים שגויים לעמודות מחוז, רשות, מפקדת ומנה"ד.
   כך נוצר מצב שמספר אישי כמו 9664234 הופיע כשם מנה"ד.

   הפונקציה מזהה ומתקנת שני סוגי זיהום:
     1. ערך מספרי בעמודת שם (מנה"ד, מפקדת, מחוז, רשות)
     2. ערך שסותר את טבלת המיפוי, כשלמיפוי יש ערך יחיד וודאי

   דורשת אישור, ומדווחת בדיוק מה תוקן.
   ============================================================================ */

function repairFromMapping() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const ui = SpreadsheetApp.getUi();
  const o = getObservations_();
  const sh = o.sheet;
  const m = o.map;
  const mapping = getMapping_();

  const F = {
    mash:   findCol_(m, 'משקית'),  mahoz: findCol_(m, 'מחוז'),
    rashut: findCol_(m, 'רשות'),   mef:   findCol_(m, 'מפקדת'),
    maMef:  findCol_(m, 'מ.א מפקדת'), manhad: findCol_(m, 'מנהד אזורי')
  };
  if (F.mash < 0) { ui.alert('לא נמצאה עמודת מש"קית'); return; }

  const n = o.lastRow - CFG.FIRST_ROW + 1;
  if (n < 1) { ui.alert('אין שורות לבדיקה'); return; }

  const col = {};
  Object.keys(F).forEach(function (k) {
    if (F[k] >= 0) col[k] = sh.getRange(CFG.FIRST_ROW, F[k] + 1, n, 1).getValues();
  });

  const NAME_FIELDS = [['mahoz','מחוז'], ['rashut','רשות'],
                       ['mef','מפקדת'], ['manhad','מנה"ד']];
  const found = [];

  for (let i = 0; i < n; i++) {
    const row = CFG.FIRST_ROW + i;
    const name = String(col.mash[i][0] || '').trim();
    if (!name) continue;

    NAME_FIELDS.forEach(function (f) {
      if (!col[f[0]]) return;
      const v = String(col[f[0]][i][0] || '').trim();
      if (v && /^\d{5,}$/.test(v)) found.push([i, f[0], f[1], v, 'מספר אישי בעמודת שם']);
    });

    const e = mapping[name];
    if (!e) continue;
    [['mef', only_(e.mef), 'מפקדת'], ['maMef', only_(e.maMef), 'מ.א מפקדת']]
      .forEach(function (p) {
        if (!col[p[0]] || !p[1]) return;
        const v = String(col[p[0]][i][0] || '').trim();
        if (v && v !== String(p[1]).trim()) {
          found.push([i, p[0], p[2], v, 'סותר את המיפוי (' + p[1] + ')']);
        }
      });
  }

  if (!found.length) { ui.alert('לא נמצאו נתונים לתיקון'); return; }

  const preview = found.slice(0, 12).map(function (f) {
    return 'שורה ' + (CFG.FIRST_ROW + f[0]) + ' — ' + f[2] +
           ': "' + f[3] + '" (' + f[4] + ')';
  }).join('\n');

  const ans = ui.alert('תיקון נתונים',
    'נמצאו ' + found.length + ' ערכים שגויים.\n\n' + preview +
    (found.length > 12 ? '\n... ועוד ' + (found.length - 12) : '') +
    '\n\nלנקות אותם ולמלא מחדש מטבלת המיפוי?', ui.ButtonSet.YES_NO);
  if (ans !== ui.Button.YES) return;

  const touched = {};
  found.forEach(function (f) {
    col[f[1]][f[0]][0] = '';
    touched[f[1]] = true;
  });
  Object.keys(touched).forEach(function (k) {
    sh.getRange(CFG.FIRST_ROW, F[k] + 1, n, 1).setValues(col[k]);
  });

  fillAllFromMapping();
  ui.alert('תוקן', found.length + ' ערכים נוקו ומולאו מחדש מהמיפוי.',
           ui.ButtonSet.OK);
}

/* ============================================================================
   פרק 26 — ניקוי גיליונות מיותרים
   ============================================================================
   מזהה גיליונות שהוחלפו או שוכפלו ומציע למחוק. לא מוחק כלום
   בלי אישור, ולא נוגע בגיליונות שהמערכת בונה.
   ============================================================================ */

function listOrphanSheets() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();

  // גיליונות שהמערכת בונה או קוראת
  const BUILT = scriptSheets_();

  const SOURCE = [CFG.SRC, CFG.DATA_SHEET, CFG.HELPER_SHEET, CFG.SCHOOLS_HELPER]
    .concat(CFG.MANUAL_SHEETS || []);

  const out = [];
  ss.getSheets().forEach(function (s) {
    const nm = s.getName();
    let status, why;
    if (SOURCE.indexOf(nm) !== -1) {
      status = 'מקור';
      why = nm === CFG.SRC ? 'הגיליון הראשי — הסקריפט מעצב אותו אך לא בונה מחדש'
          : (nm === CFG.DATA_SHEET ? 'רשימות מקור — נקרא בלבד, מתוחזק ידנית'
          : 'נוסחאות פריסת השיעורים — הסקריפט מרחיב שורות בלבד');
    } else if (BUILT.indexOf(nm) !== -1) {
      status = 'נבנה';
      why = 'נבנה מחדש בכל "הפעל הכול"';
    } else {
      status = 'לא מעודכן';
      why = 'הסקריפט לא נוגע בו — לא נבנה, לא מעוצב, לא נקרא';
    }
    out.push([status, nm, s.getLastRow(), s.getLastColumn(), why]);
  });

  out.sort(function (a, b) {
    const ord = { 'לא מעודכן': 0, 'מקור': 1, 'נבנה': 2 };
    if (ord[a[0]] !== ord[b[0]]) return ord[a[0]] - ord[b[0]];
    return b[2] - a[2];
  });

  const head = ['סטטוס', 'שם הגיליון', 'שורות', 'עמודות', 'הסבר'];
  const sh = outSheet_('דוח גיליונות');
  ensureCols_(sh, head.length + 2);
  sh.getRange(1, 1, 1, head.length).setValues([head]);
  sh.getRange(2, 1, out.length, head.length).setValues(out);

  styleOutput_(sh, head.length, out.length, 'כלי', [1, 4]);
  sh.setColumnWidth(5, 420);
  sh.getRange(2, 5, out.length, 1).setHorizontalAlignment('right').setWrap(true);

  sh.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule()
      .setRanges([sh.getRange(2, 1, out.length, head.length)])
      .whenFormulaSatisfied('=$A2="לא מעודכן"').setBackground(THEME.WARN).build(),
    SpreadsheetApp.newConditionalFormatRule()
      .setRanges([sh.getRange(2, 1, out.length, head.length)])
      .whenFormulaSatisfied('=$A2="מקור"').setBackground(THEME.CAT_A).build()
  ]);

  const orphans = out.filter(function (r) { return r[0] === 'לא מעודכן'; }).length;
  ss.setActiveSheet(sh);
  ss.toast(orphans + ' גיליונות אינם מתעדכנים מהסקריפט. שום דבר לא נמחק.',
           'דוח גיליונות', 15);
}



/* ============================================================================
   פרק 27 — הפעלה מלאה: כפתור אחד
   ============================================================================
   מריץ את כל המערכת בסדר הנכון. אפשר להריץ בכל פעם —
   הכול נבנה מחדש ולא משוכפל.

   הסדר אינו שרירותי:
     מיפוי ראשון    — כל השאר נשען עליו
     ניתוחים אחריו  — הם יוצרים את הגיליונות
     עיצוב אחריהם   — אין טעם לעצב מה שלא נוצר
     מסך בית        — הוא מקשר לגיליונות שכבר קיימים
     הרשאות אחרונות — הן נועלות את מה שקיים
   ============================================================================ */

/* ============================================================================
   תיקון מהיר — לרוץ אחרי שינוי מבנה, בלי "הפעל הכול"
   ============================================================================
   מריץ רק את מה שמחזיר את גיליון ההזנה לתקינות:
   עמודות פלוגה ומחזור, נוסחת הציון, הרשימות הנפתחות,
   והמילוי מהמיפוי. כמה שניות, לא דקות.
   ============================================================================ */

function quickFix() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const t0 = Date.now();
  const errors = [];
  const step = function (name, fn) {
    ss.toast(name, '\u26a1 תיקון מהיר', 60);
    try { fn(); } catch (err) { errors.push(name + ': ' + err.message); }
  };

  step('עמודות פלוגה ומחזור', ensureMainColumns);
  step('נוסחת הציון',        restoreScoreFormula);
  step('רשימות נפתחות',      repairValidations);
  step('מילוי מהמיפוי',      fillAllFromMapping);

  const secs = Math.round((Date.now() - t0) / 1000);
  ss.toast(errors.length ? 'שגיאות: ' + errors.join(' | ')
                         : 'הכול תוקן ב-' + secs + ' שניות',
           errors.length ? 'הושלם חלקית' : '\u2705 מוכן', 20);
}


/* ============================================================================
   פרק 36 — מד התקדמות
   ============================================================================
   מחזיר פונקציית step שמציגה הודעה לפני כל שלב, מודדת את
   זמנו, ושומרת את הזמנים לשימוש בחישוב הצפי בהרצה הבאה.
   ============================================================================ */

function fmtMMSS_(ms) {
  const sec = Math.max(0, Math.round(ms / 1000));
  const m = Math.floor(sec / 60);
  const r = sec % 60;
  return m + ':' + (r < 10 ? '0' : '') + r;
}




/* ============================================================================
   פרק 37 — מנוע הרצה מפוצל
   ============================================================================
   Apps Script עוצר כל הרצה אחרי שש דקות. ההרצה המלאה ארוכה
   מזה, ולכן היא מחולקת למקטעים.

   בסוף מקטע נשמר המצב ב-PropertiesService ונוצר טריגר
   חד-פעמי שממשיך מהנקודה המדויקת. המשתמש רואה הודעה אחת
   ("ממשיך ברקע") וזהו.

   שלב לא מתחיל אם לפי המדידות הקודמות אין לו מספיק זמן
   להסתיים בתוך המקטע — כך הוא לא נקטע באמצע.
   ============================================================================ */

const RUN_PROP = 'RUN_STATE';
const CONT_FN = 'continueRun_';
const PROG_KEY = 'RUN_PROGRESS';


/** כותב תמונת מצב של ההרצה, לקריאה על ידי חלון ההתקדמות. */
function progressPut_(obj) {
  try {
    CacheService.getDocumentCache()
      .put(PROG_KEY, JSON.stringify(obj), 900);
  } catch (err) {}
}

/** נקרא מתוך חלון ההתקדמות כל שתי שניות. */
function getRunProgress() {
  try {
    const raw = CacheService.getDocumentCache().get(PROG_KEY);
    return raw ? JSON.parse(raw) : null;
  } catch (err) { return null; }
}

/** מופעל מתוך החלון, מיד אחרי שהוא נטען. */
function uiStartRun() {
  startRun_('full');
  return true;
}

/** עצירה מתוך החלון, בלי חלונית אישור. */
function uiStopRun() {
  killContinuations_();
  clearState_();
  const p = getRunProgress() || {};
  p.finished = true;
  p.stopped = true;
  progressPut_(p);
  return true;
}


/** שם שלב -> הפונקציה שמריצה אותו. */
/**
 * מריץ פעולה עם ניסיונות חוזרים על שגיאות תשתית זמניות
 * של Sheets. שגיאה אמיתית בקוד נזרקת מיד.
 *
 * @return {number} מספר הניסיונות שנדרשו
 */
function withRetry_(fn, tries) {
  const WAIT = [3000, 8000, 15000];
  const max = tries || 4;
  const TRANSIENT = [
    'שירות גיליונות אלקטרוניים',
    'Spreadsheet service',
    'Service Spreadsheets',
    'Service error',
    'Internal error',
    'שגיאה פנימית',
    'try again',
    'נסה שוב',
    'timed out',
    'temporarily unavailable'
  ];

  for (let i = 1; i <= max; i++) {
    try {
      fn();
      return i;
    } catch (err) {
      const msg = String(err && err.message ? err.message : err);
      const transient = TRANSIENT.some(function (t) {
        return msg.indexOf(t) !== -1;
      });
      if (!transient || i === max) throw err;

      try { SpreadsheetApp.flush(); } catch (e2) {}
      Utilities.sleep(WAIT[i - 1] || 15000);
    }
  }
}


/* ============================================================================
   פרק 38 — תיקון טקסט לבן על רקע בהיר
   ============================================================================ */

/** בהירות יחסית של צבע hex. 0 = שחור, 1 = לבן. */
function lum_(hex) {
  const h = String(hex || '').trim().toLowerCase();
  if (h === 'white') return 1;
  if (h === 'black') return 0;
  const m = h.match(/^#?([0-9a-f]{6})$/);
  if (!m) return 0.5;
  const v = m[1];
  const r = parseInt(v.substr(0, 2), 16) / 255;
  const g = parseInt(v.substr(2, 2), 16) / 255;
  const b = parseInt(v.substr(4, 2), 16) / 255;
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}


/**
 * כלל פשוט: רקע בהיר -> טקסט שחור.
 *
 * סורקת כל גיליון, משווה בהירות של רקע מול בהירות של גופן,
 * ומשחירה כל גופן שאינו כהה דיו. מטפלת גם בתאים עם טקסט
 * עשיר (קישורים וכפתורים), שהם הסיבה שהגרסה הקודמת החמיצה
 * חלק מהמקומות.
 */
function fixWhiteText() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const BLACK = '#000000';

  const SKIP = (CFG.MANUAL_SHEETS || [])
    .concat(CFG.NO_FORMAT || []).concat([CFG.SRC]);

  const BLOCK = 400;        // שורות בכל מעבר
  const FONT_LIGHT = 0.45;  // גופן בהיר מזה -> מושחר
  const BG_LIGHT = 0.55;    // רקע בהיר מזה -> נחשב בהיר

  let fixed = 0, rich = 0;
  const report = [];

  ss.getSheets().forEach(function (sh) {
    const name = sh.getName();
    if (SKIP.indexOf(name) !== -1) return;

    const lastRow = sh.getLastRow();
    const lastCol = sh.getLastColumn();
    if (lastRow < 1 || lastCol < 1) return;

    // תאים ממוזגים: getBackgrounds מחזיר לבן לכל תא שאינו
    // העוגן, ולכן כותרת לבנה על רקע כהה נראית כמו לבן על
    // לבן. מדלגים עליהם לגמרי.
    const inMerge = {};
    try {
      sh.getMergedRanges().forEach(function (mr) {
        const r0 = mr.getRow(), c0 = mr.getColumn();
        const rN = mr.getNumRows(), cN = mr.getNumColumns();
        for (let r = r0; r < r0 + rN; r++) {
          for (let c = c0; c < c0 + cN; c++) inMerge[r + ',' + c] = true;
        }
      });
    } catch (err) {}

    let here = 0;

    for (let top = 1; top <= lastRow; top += BLOCK) {
      const n = Math.min(BLOCK, lastRow - top + 1);
      const rng = sh.getRange(top, 1, n, lastCol);

      const fonts = rng.getFontColors();
      const bgs = rng.getBackgrounds();
      let changed = false;

      for (let r = 0; r < n; r++) {
        for (let c = 0; c < lastCol; c++) {
          if (inMerge[(top + r) + ',' + (c + 1)]) continue;
          if (lum_(bgs[r][c]) > BG_LIGHT && lum_(fonts[r][c]) > FONT_LIGHT) {
            fonts[r][c] = BLACK;
            changed = true;
            here++;
          }
        }
      }

      if (changed) rng.setFontColors(fonts);

      // ---- טקסט עשיר: setFontColors לא נוגעת בו ----
      try {
        const rtv = rng.getRichTextValues();
        for (let r = 0; r < n; r++) {
          for (let c = 0; c < lastCol; c++) {
            if (inMerge[(top + r) + ',' + (c + 1)]) continue;
            const v = rtv[r][c];
            if (!v) continue;
            const text = v.getText();
            if (!text) continue;
            if (lum_(bgs[r][c]) <= BG_LIGHT) continue;

            const runs = v.getRuns();
            let needs = false;
            runs.forEach(function (run) {
              const st2 = run.getTextStyle();
              const fc = st2.getForegroundColor();
              if (fc && lum_(fc) > FONT_LIGHT) needs = true;
            });
            if (!needs) continue;

            const b = SpreadsheetApp.newRichTextValue().setText(text);
            runs.forEach(function (run) {
              const s0 = run.getStartIndex(), e0 = run.getEndIndex();
              const old = run.getTextStyle();
              const nb = SpreadsheetApp.newTextStyle()
                .setForegroundColor(BLACK)
                .setBold(old.isBold())
                .setItalic(old.isItalic())
                .setUnderline(old.isUnderline());
              const fs = old.getFontSize(); if (fs) nb.setFontSize(fs);
              const ff = old.getFontFamily(); if (ff) nb.setFontFamily(ff);
              b.setTextStyle(s0, e0, nb.build());
              const url = run.getLinkUrl();
              if (url) b.setLinkUrl(s0, e0, url);
            });
            sh.getRange(top + r, c + 1).setRichTextValue(b.build());
            rich++;
            here++;
          }
        }
      } catch (err) {}
    }

    if (here) report.push(name + ': ' + here);
    fixed += here;
  });

  const msg = fixed
    ? 'הושחרו ' + fixed + ' תאים' +
      (rich ? ' (מתוכם ' + rich + ' עם קישור)' : '') + '.\n\n' +
      report.join('\n')
    : 'לא נמצא טקסט בהיר על רקע בהיר.';

  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('תיקון טקסט בהיר', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'תיקון טקסט בהיר', 20); } catch (e2) {}
  }
  return fixed;
}


/**
 * טקסט שחור בכל תא שיש בו תיבת בחירה.
 *
 * מזהה לפי קיום אימות נתונים בתא. לא נוגעת בשום תא אחר,
 * לא ברקעים ולא בעיצוב המותנה.
 */
function blackenDropdowns() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();
  const BLACK = '#000000';
  const BLOCK = 400;

  const SKIP = (CFG.MANUAL_SHEETS || [])
    .concat(CFG.NO_FORMAT || []).concat([CFG.SRC]);

  let fixed = 0, merged = 0;
  const report = [];

  ss.getSheets().forEach(function (sh) {
    if (SKIP.indexOf(sh.getName()) !== -1) return;
    const lastRow = sh.getLastRow();
    const lastCol = sh.getLastColumn();
    if (lastRow < 1 || lastCol < 1) return;

    let here = 0;

    for (let top = 1; top <= lastRow; top += BLOCK) {
      const n = Math.min(BLOCK, lastRow - top + 1);
      const rng = sh.getRange(top, 1, n, lastCol);

      let dv;
      try { dv = rng.getDataValidations(); }
      catch (err) { continue; }

      const fonts = rng.getFontColors();
      let changed = false;

      for (let r = 0; r < n; r++) {
        for (let c = 0; c < lastCol; c++) {
          if (!dv[r][c]) continue;
          if (String(fonts[r][c]).toLowerCase() === BLACK) continue;
          fonts[r][c] = BLACK;
          changed = true;
          here++;
        }
      }

      if (changed) rng.setFontColors(fonts);
    }

    // ---- תאים ממוזגים: נבדקים אחד-אחד ----
    try {
      sh.getMergedRanges().forEach(function (mr) {
        let rule = null;
        try { rule = mr.getDataValidation(); } catch (err) { return; }
        if (!rule) return;
        if (String(mr.getFontColor()).toLowerCase() === BLACK) return;
        mr.setFontColor(BLACK);
        here++;
        merged++;
      });
    } catch (err) {}

    if (here) report.push(sh.getName() + ': ' + here);
    fixed += here;
  });

  const msg = fixed
    ? 'הושחרו ' + fixed + ' תיבות בחירה' +
      (merged ? ' (מתוכן ' + merged + ' ממוזגות)' : '') + '.\n\n' +
      report.join('\n')
    : 'כל תיבות הבחירה כבר בשחור.';

  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('טקסט בתיבות בחירה', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'תיבות בחירה', 15); } catch (e2) {}
  }
  return fixed;
}


