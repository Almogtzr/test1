    .setValue('1. "הוספת תצפית חדשה" מקפיץ לשורה הפנויה — מסמנים תחילת תצפית וממלאים.   ' +
              '2. שדות הזיהוי מתמלאים לבד לפי טבלת המיפוי.   ' +
              '3. בסיום מסמנים "סיום תצפית והפקת דוח".   ' +
              '4. הניתוחים מתעדכנים כל בוקר ב-5:00.')
    .setFontSize(10).setFontColor(THEME.INK_SOFT).setWrap(true)
    .setHorizontalAlignment('right').setVerticalAlignment('middle');
  home.setRowHeight(row, 46);

  home.hideColumns(14, 3);
  home.setFrozenRows(2);
  ss.setActiveSheet(home);
  ss.moveActiveSheet(1);
  ss.toast('מסך הבית נבנה', 'הושלם', 8);
}


function section_(sh, row, text) {
  sh.getRange(row, 1, 1, 12).merge().setValue('  ' + text)
    .setFontSize(13).setFontWeight('bold')
    .setFontColor(THEME.INK_STRONG).setBackground(THEME.SURFACE)
    .setHorizontalAlignment('right').setVerticalAlignment('middle')
    .setBorder(null, null, true, null, null, null,
               THEME.FRAME, SpreadsheetApp.BorderStyle.SOLID_MEDIUM);
  sh.setRowHeight(row, 30);
}

function bigButton_(sh, row, col, span, formula, color) {
  const area = sh.getRange(row, col, 2, span).merge();
  area.setFormula(formula)
    .setFontSize(15).setFontWeight('bold').setFontColor(THEME.INK_STRONG)
    .setBackground(color).setFontLine('none')
    .setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setBorder(true, true, true, true, false, false,
               '#0D2231', SpreadsheetApp.BorderStyle.SOLID_THICK);
}

function linkTile_(sh, row, col, span, name, gid, bg) {
  const area = sh.getRange(row, col, 1, span).merge();
  area.setFormula('=HYPERLINK("#gid=' + gid + '","' + name.replace(/"/g, '""') + '")')
    .setFontSize(11).setFontWeight('bold').setFontColor(THEME.INK_STRONG)
    .setBackground(bg).setFontLine('none')
    .setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setBorder(true, true, true, true, false, false,
               THEME.HEAD_LINE, SpreadsheetApp.BorderStyle.SOLID);
}



/* ============================================================================
   פרק 23 — תפריט וטריגרים
   ============================================================================

   טריגרים להתקנה ידנית (עורך הסקריפטים > סמל השעון):

   1. onEditInstalled     מגיליון אלקטרוני, בעריכה   <-- חובה
   2. refreshEverything   מבוסס-זמן, יומי, 05:00
   3. onStructureChange   מגיליון אלקטרוני, בעת שינוי
   4. topUpRowPool        מבוסס-זמן, שבועי
   5. buildMonthlySnapshot  מבוסס-זמן, חודשי  (מומלץ)
   ============================================================================ */

function onEditInstalled(e) {
  if (!e || !e.range) return;

  // שינוי רשות מנקה את בית הספר — הוא שייך לרשות הקודמת
  try {
    const sh0 = e.range.getSheet();
    if (sh0.getName() === CFG.SRC && e.range.getRow() >= CFG.FIRST_ROW &&
        e.range.getNumRows() === 1 && e.range.getNumColumns() === 1) {
      const m0 = colMap_(sh0);
      const iR = findCol_(m0, 'רשות');
      const iS = findCol_(m0, 'בית ספר');
      if (iR >= 0 && iS >= 0 && e.range.getColumn() === iR + 1 &&
          String(e.value || '') !== String(e.oldValue || '')) {
        const cell = sh0.getRange(e.range.getRow(), iS + 1);
        if (!cell.getFormula()) cell.clearContent();
      }
    }
  } catch (err) {}

  try {
    const sh = e.range.getSheet();
    if (sh.getName() === CFG.CARD_SHEET &&
        e.range.getRow() === 2 && e.range.getColumn() === 2) {
      renderMashakitCard_(String(e.value || '').trim());
      return;
    }
  } catch (err) {}

  autoFillFromMapping_(e);
  logChange_(e);
}


function refreshEverything() {
  const ss = SpreadsheetApp.getActive();
  const D = CFG.DAILY || {};
  const props = PropertiesService.getDocumentProperties();

  // הרצה קודמת עדיין פעילה? לא פותחים שנייה.
  if (runState_()) return;

  // ---- סנכרון השיוך: פעם בשבוע, או כשהמיפוי חסר ----
  const mapSh = ss.getSheetByName(CFG.MAPPING_SHEET);
  const mapEmpty = !mapSh || mapSh.getLastRow() < 3;
  const rosterDay = new Date().getDay() ===
    (D.rosterDay === undefined ? 0 : D.rosterDay);
  const syncRoster = rosterDay || mapEmpty;

  if (syncRoster) {
    try { buildMappingSheet(); } catch (err) {}
  }

  // ---- טביעת אצבע: אם שום דבר לא השתנה, אין מה לבנות ----
  let fp = '';
  try {
    const o = getObservations_();
    let sum = 0, fb = 0;
    o.rows.forEach(function (r) {
      const v = Number(r[o.c.score]);
      if (!isNaN(v)) sum += v;
      if (String(r[o.c.feedback]).trim() === 'כן') fb++;
    });
    fp = o.rows.length + '|' + Math.round(sum) + '|' + fb;
  } catch (err) {}

  if (D.skipIfSame && fp && !syncRoster &&
      props.getProperty('DAILY_FP') === fp) {
    try {
      const log = ss.getSheetByName(CFG.LOG_SHEET);
      if (log) {
        log.getRange(log.getLastRow() + 1, 1, 1, 8).setValues([[
          new Date(), 'רענון יומי', CFG.SRC, '', '',
          'דילוג', '', 'אין נתונים חדשים (' + fp + ')'
        ]]);
      }
    } catch (err) {}
    return;
  }

  startRun_('daily', { fp: fp });
}



function onStructureChange(e) {
  if (!e) return;
  if (e.changeType !== 'INSERT_ROW' && e.changeType !== 'REMOVE_ROW') return;
  syncLessonValidation();
  syncObserverValidation();
}


/* ============================================================================
   פרק 33 — הרשאות לתפריט הניהול
   ============================================================================
   שתי שכבות:

   1. onOpen בונה את התפריט המלא רק למי שברשימת המנהלים,
      או למי שפתח עם סיסמה.

   2. guard_ יושבת בראש כל פונקציית ניהול. היא נחוצה כי
      הסתרת תפריט היא קוסמטיקה בלבד — מי שיש לו הרשאת
      עריכה יכול לפתוח את עורך הסקריפטים ולהריץ כל פונקציה
      ישירות. guard_ עוצרת אותו שם.

   טריגרים תמיד עוברים: הם רצים בשם מי שהתקין אותם, כלומר בשמך.
   ============================================================================ */

function isAdmin_() {
  const list = (CFG.ADMIN_EMAILS || []).map(function (x) {
    return String(x).trim().toLowerCase();
  });

  let who = '';
  try { who = String(Session.getActiveUser().getEmail() || '').toLowerCase(); }
  catch (err) {}
  if (!who) {
    try { who = String(Session.getEffectiveUser().getEmail() || '').toLowerCase(); }
    catch (err) {}
  }
  if (who && list.indexOf(who) !== -1) return true;

  try {
    if (PropertiesService.getUserProperties()
          .getProperty(CFG.UNLOCK_PROP) === '1') return true;
  } catch (err) {}

  return false;
}


/** האם אנחנו בתוך טריגר (אין ממשק משתמש זמין). */
function inTriggerContext_() {
  try { SpreadsheetApp.getUi(); return false; }
  catch (err) { return true; }
}


/** שומר הסף של כל פונקציית ניהול. */
function guard_() {
  if (inTriggerContext_()) return true;
  if (isAdmin_()) return true;
  try {
    SpreadsheetApp.getActive().toast(
      'הפעולה שמורה למנהל המערכת.', 'אין הרשאה', 6);
  } catch (err) {}
  return false;
}


/** פתיחת התפריט המלא בסיסמה — למי שאינו ברשימת המנהלים. */
function unlockTools() {
  const ui = SpreadsheetApp.getUi();
  const want = PropertiesService.getScriptProperties()
    .getProperty(CFG.ADMIN_PASS_PROP);

  if (!want) {
    ui.alert('לא הוגדרה סיסמה',
      'מנהל המערכת צריך להריץ פעם אחת את setAdminPassword ' +
      'מתוך עורך הסקריפטים.', ui.ButtonSet.OK);
    return;
  }

  const res = ui.prompt('כלי ניהול', 'הקלד סיסמה:', ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;

  if (res.getResponseText().trim() === want) {
    PropertiesService.getUserProperties().setProperty(CFG.UNLOCK_PROP, '1');
    ui.alert('נפתח', 'רענן את הקובץ (F5) והתפריט המלא יופיע.', ui.ButtonSet.OK);
  } else {
    ui.alert('סיסמה שגויה', 'נסה שוב.', ui.ButtonSet.OK);
  }
}


/** נעילה חוזרת של התפריט למשתמש הנוכחי. */
function lockTools() {
  const ui = SpreadsheetApp.getUi();
  try { PropertiesService.getUserProperties().deleteProperty(CFG.UNLOCK_PROP); }
  catch (err) {}
  ui.alert('ננעל', 'רענן את הקובץ (F5).', ui.ButtonSet.OK);
}


/** הגדרת הסיסמה. נשמרת בהגדרות הסקריפט ולא בתוך הקוד. */
function setAdminPassword() {
  const ui = SpreadsheetApp.getUi();
  if (!isAdmin_()) { ui.alert('אין הרשאה'); return; }

  const res = ui.prompt('סיסמת ניהול',
    'הקלד סיסמה חדשה. היא נשמרת בהגדרות הסקריפט, לא בקוד.',
    ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;

  const t = res.getResponseText().trim();
  if (!t) { ui.alert('לא הוזנה סיסמה'); return; }

  PropertiesService.getScriptProperties().setProperty(CFG.ADMIN_PASS_PROP, t);
  ui.alert('נשמר', 'הסיסמה עודכנה.', ui.ButtonSet.OK);
}


/* ============================================================================
   פרק 34 — אבחון טריגרים ותפריטים זרים
   ============================================================================
   למה זה קיים: בקובץ מופיע תפריט שלא נבנה מהקוד הזה.
   בפרויקט Apps Script אחד יכולה להתקיים רק פונקציה אחת בשם
   onOpen, ולכן תפריט נוסף מגיע תמיד מאחד משניים:

     1. טריגר onOpen מותקן שמפנה לפונקציה בשם אחר  -> ניתן למחוק כאן
     2. קובץ .gs נוסף בפרויקט                      -> רק עריכה ידנית
     3. תוסף (Add-on) מותקן                        -> הסרה מניהול תוספים

   reportTriggers מכריעה בין האפשרויות.
   ============================================================================ */

function reportTriggers() {
  if (!guard_()) return;
  const ui = SpreadsheetApp.getUi();
  const trg = ScriptApp.getProjectTriggers();

  if (!trg.length) {
    ui.alert('אין טריגרים',
      'בפרויקט אין אף טריגר מותקן.\n\n' +
      'המשמעות: התפריט הזר מגיע מקובץ .gs נוסף בפרויקט, ' +
      'או מתוסף מותקן. הסר אותו ידנית — ראה הסבר בתפריט.',
      ui.ButtonSet.OK);
    return;
  }

  const EVENT = {};
  EVENT[ScriptApp.EventType.ON_OPEN]   = 'פתיחת הקובץ';
  EVENT[ScriptApp.EventType.ON_EDIT]   = 'עריכה';
  EVENT[ScriptApp.EventType.ON_CHANGE] = 'שינוי מבנה';
  EVENT[ScriptApp.EventType.CLOCK]     = 'מבוסס זמן';

  const mine = {};
  ['onOpen'].concat(CFG.MY_TRIGGERS).forEach(function (n) { mine[n] = true; });


  const lines = [];
  let foreign = 0;

  trg.forEach(function (t) {
    const fn = t.getHandlerFunction();
    const ev = EVENT[t.getEventType()] || String(t.getEventType());
    const ok = mine[fn] ? '' : '   <-- לא מהקוד הזה';
    if (!mine[fn]) foreign++;
    lines.push(fn + '  |  ' + ev + ok);
  });

  ui.alert('טריגרים בפרויקט (' + trg.length + ')',
    lines.join('\n') + '\n\n' +
    (foreign
      ? foreign + ' טריגרים שאינם מהקוד הזה.\n' +
        'אם אחד מהם הוא "פתיחת הקובץ" — הוא זה שבונה את התפריט הזר. ' +
        'הרץ "מחק טריגרים זרים".'
      : 'כל הטריגרים שייכים לקוד הזה.\n' +
        'המשמעות: התפריט הזר מגיע מקובץ .gs נוסף בפרויקט או מתוסף.'),
    ui.ButtonSet.OK);
}


function removeForeignTriggers() {
  if (!guard_()) return;
  const ui = SpreadsheetApp.getUi();
  const trg = ScriptApp.getProjectTriggers();

  const kill = trg.filter(function (t) {
    return t.getEventType() === ScriptApp.EventType.ON_OPEN &&
           t.getHandlerFunction() !== 'onOpen';
  });

  if (!kill.length) {
    ui.alert('לא נמצא',
      'אין טריגר פתיחה שמפנה לפונקציה זרה.\n\n' +
      'התפריט מגיע אם כן מקובץ .gs נוסף בפרויקט או מתוסף מותקן. ' +
      'הרץ "דוח טריגרים" לתמונה מלאה.', ui.ButtonSet.OK);
    return;
  }

  const names = kill.map(function (t) { return t.getHandlerFunction(); });
  const res = ui.alert('מחיקת טריגרים זרים',
    'נמצאו ' + kill.length + ' טריגרי פתיחה שאינם מהקוד הזה:\n\n' +
    names.join('\n') + '\n\n' +
    'למחוק אותם? הקוד עצמו לא נמחק — רק ההפעלה האוטומטית שלו ' +
    'בפתיחת הקובץ. אפשר להחזיר בכל רגע.',
    ui.ButtonSet.YES_NO);
  if (res !== ui.Button.YES) return;

  kill.forEach(function (t) { ScriptApp.deleteTrigger(t); });

  ui.alert('בוצע',
    kill.length + ' טריגרים נמחקו.\n\nרענן את הקובץ (F5) — התפריט אמור להיעלם.',
    ui.ButtonSet.OK);
}


