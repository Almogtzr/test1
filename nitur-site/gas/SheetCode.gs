/* ============================================================================
   פרק 1 — תשתית
   ============================================================================ */

function colMap_(sh, headerRow) {
  const row = headerRow || CFG.HEADER_ROW;
  const hdr = sh.getRange(row, 1, 1, sh.getLastColumn()).getValues()[0];
  const m = {};
  hdr.forEach(function (h, i) {
    const k = String(h).trim();
    if (k && !(k in m)) m[k] = i;
  });
  return m;
}

function findCol_(m, needle) {
  if (needle in m) return m[needle];
  const keys = Object.keys(m);
  let k = keys.filter(function (x) { return x.indexOf(needle) === 0; })[0];
  if (!k) k = keys.filter(function (x) { return x.indexOf(needle) > -1; })[0];
  return k === undefined ? -1 : m[k];
}

function ensureCols_(sh, needed) {
  const have = sh.getMaxColumns();
  if (have < needed) sh.insertColumnsAfter(have, needed - have);
}
function ensureRows_(sh, needed) {
  const have = sh.getMaxRows();
  if (have < needed) sh.insertRowsAfter(have, needed - have);
}


/**
 * שורת הנתונים האחרונה האמיתית.
 *
 * getLastRow מחזיר את סוף המאגר (אלפי שורות) כי יש שם נוסחאות
 * ותיבות סימון. הפונקציה הזו קוראת עמודה אחת בלבד — התאריך —
 * וסורקת מהסוף אחורה. זה מה שהפך את הקובץ ממהיר לאיטי, ומה
 * שמחזיר אותו למהיר.
 */
function lastDataRow_(sh, dateIdx) {
  const maxR = sh.getMaxRows();
  const n = maxR - CFG.FIRST_ROW + 1;
  if (n < 1) return CFG.FIRST_ROW;
  const col = sh.getRange(CFG.FIRST_ROW, dateIdx + 1, n, 1).getValues();
  for (let i = n - 1; i >= 0; i--) {
    if (String(col[i][0]).trim() !== '') return CFG.FIRST_ROW + i;
  }
  return CFG.FIRST_ROW;
}


var _OBS_CACHE = null;

/** מאפס את זיכרון קריאת גיליון ההזנה. */
function clearObsCache_() {
  _OBS_CACHE = null;
  _PLUG_BY_RASHUT = null;
}

function getObservations_() {
  if (_OBS_CACHE) return _OBS_CACHE;
  const sh = SpreadsheetApp.getActive().getSheetByName(CFG.SRC);
  if (!sh) throw new Error('לא נמצא הגיליון ' + CFG.SRC);

  const m = colMap_(sh);
  const c = {
    check: 1,
    mahoz:       findCol_(m, 'מחוז'),
    plugah:      findCol_(m, 'פלוגה'),
    machzor:     findCol_(m, 'מחזור'),
    rashut:      findCol_(m, 'רשות'),
    manhad:      findCol_(m, 'מנהד אזורי'),
    mefakedet:   findCol_(m, 'מפקדת'),
    maMefakedet: findCol_(m, 'מ.א מפקדת'),
    mashakit:    findCol_(m, 'משקית'),
    maMashakit:  findCol_(m, 'מ.א מש"קית'),
    mitgaberet:  findCol_(m, 'מש"קית מתגברת'),
    school:      findCol_(m, 'בית ספר'),
    kita:        findCol_(m, 'כיתה'),
    shift:       findCol_(m, 'שם השיפט'),
    lesson:      findCol_(m, 'שם ומספר שיעור'),
    role:        findCol_(m, 'תפקיד המתצפת'),
    observer:    findCol_(m, 'שם המתצפת'),
    date:        findCol_(m, 'תאריך'),
    score:       findCol_(m, 'ציון תצפית'),
    support:     findCol_(m, 'תפקוד המתגברת'),
    feedback:    findCol_(m, 'הועבר משוב'),
    cat360:      findCol_(m, 'קוטלג ב360'),
    done:        findCol_(m, 'סיום תצפית')
  };

  // קריטריון + עמודת הפירוט שצמודה אליו
  const headers = sh.getRange(CFG.HEADER_ROW, 1, 1, sh.getLastColumn()).getValues()[0];
  CFG.CRITERIA.forEach(function (x, i) {
    const k = findCol_(m, x[0]);
    c['k' + i] = k;
    c['d' + i] = (k >= 0 && String(headers[k + 1] || '').indexOf('פירוט') === 0)
      ? k + 1 : -1;
  });

  const last = Math.max(lastDataRow_(sh, c.date), CFG.FIRST_ROW);
  const n = last - CFG.FIRST_ROW + 1;

  let width = 0;
  Object.keys(c).forEach(function (k) { if (c[k] + 1 > width) width = c[k] + 1; });

  const raw = sh.getRange(CFG.FIRST_ROW, 1, n, width).getValues();

  const rows = [], skipped = [];
  raw.forEach(function (r, i) {
    const hasDate = (r[c.date] instanceof Date) || String(r[c.date]).trim() !== '';
    const hasName = String(r[c.mashakit]).trim() !== '';
    const touched = r[c.check] === true || hasDate || hasName;
    if (hasDate && hasName) { r._row = CFG.FIRST_ROW + i; rows.push(r); }
    else if (touched) {
      skipped.push({ row: CFG.FIRST_ROW + i,
        why: !hasDate && !hasName ? 'אין תאריך ואין מש"קית'
           : (!hasDate ? 'אין תאריך' : 'אין מש"קית') });
    }
  });

  _OBS_CACHE = { rows: rows, allRaw: raw, skipped: skipped, c: c,
                 sheet: sh, map: m, lastRow: last };
  return _OBS_CACHE;
}


function outSheet_(name) {
  const ss = SpreadsheetApp.getActive();
  let sh = ss.getSheetByName(name);
  if (!sh) { sh = ss.insertSheet(name); }
  else {
    sh.getCharts().forEach(function (ch) { sh.removeChart(ch); });
    sh.clear();
    sh.clearConditionalFormatRules();
    try { sh.showColumns(1, sh.getMaxColumns()); } catch (err) {}
  }
  return sh;
}


/**
 * גבולות לטבלה: קו דק בין התאים, מסגרת עבה מסביב,
 * וקו עבה בגבול בין קבוצות עמודות.
 *
 * @param groups מערך של מספרי עמודה שאחריהם נמתח קו מפריד
 */
function frameTable_(sh, row, col, rows, cols, groups) {
  const all = sh.getRange(row, col, rows, cols);

  // קו פנימי שחור דק בין כל התאים
  all.setBorder(null, null, null, null, true, true,
                THEME.GRID, SpreadsheetApp.BorderStyle.SOLID);

  // מסגרת חיצונית עבה
  all.setBorder(true, true, true, true, null, null,
                THEME.FRAME, SpreadsheetApp.BorderStyle.SOLID_THICK);

  // קו עבה מתחת לשורת הכותרת
  if (rows > 1) {
    sh.getRange(row, col, 1, cols).setBorder(
      null, null, true, null, null, null,
      THEME.FRAME, SpreadsheetApp.BorderStyle.SOLID_THICK);
  }

  // קווים עבים בין קבוצות עמודות
  (groups || []).forEach(function (g) {
    if (g < col || g >= col + cols) return;
    sh.getRange(row, g, rows, 1).setBorder(
      null, true, null, null, null, null,
      THEME.FRAME, SpreadsheetApp.BorderStyle.SOLID_THICK);
  });
}


/**
 * מנקה עיצוב מכל מה שנמצא מחוץ לטבלה.
 *
 * זה מה שמנע מעמודות ריקות אחרי סוף הטבלה להיראות
 * כאילו הן חלק ממנה — צבועות, עם גבולות, בלי תוכן.
 */
/**
 * מוסיף שורת תיאור מעל הכותרות.
 * נקראת בסוף כל בנייה — היא מכניסה שורה חדשה בראש, ולכן
 * טווחי העיצוב המותנה והגרפים מוסטים אוטומטית על ידי גוגל.
 */
function addDescription_(sh, text) {
  const wide = function () { return Math.max(sh.getLastColumn(), 1); };

  const rowEmpty = function (r) {
    try {
      return sh.getRange(r, 1, 1, wide()).getValues()[0]
        .every(function (v) { return String(v).trim() === ''; });
    } catch (err) { return false; }
  };

  // 1. ניקוי שורות ריקות שכבר יושבות בראש, משאריות קודמות
  try {
    let guard = 0;
    while (guard++ < 10 && sh.getMaxRows() > 2 &&
           rowEmpty(1) && !rowEmpty(2)) {
      try { sh.getRange(1, 1, 1, sh.getMaxColumns()).breakApart(); }
      catch (err) {}
      sh.deleteRow(1);
    }
  } catch (err) {}

  // 2. הוספת שורת התיאור
  let inserted = false;
  try {
    sh.insertRowBefore(1);
    inserted = true;

    const cols = wide();
    const rng = sh.getRange(1, 1, 1, cols);

    // מיזוג ישן שנשאר מבנייה קודמת מפיל את merge
    try { rng.breakApart(); } catch (err) {}

    rng.merge()
      .setValue(text)
      .setFontFamily('Arial').setFontSize(11)
      .setFontColor(THEME.INK_STRONG).setBackground('#FFF7E0')
      .setHorizontalAlignment('right').setVerticalAlignment('middle')
      .setWrap(true)
      .setBorder(true, true, true, true, false, false,
                 THEME.FRAME, SpreadsheetApp.BorderStyle.SOLID_THICK);
    sh.setRowHeight(1, 46);
    sh.setFrozenRows(2);
  } catch (err) {
    // 3. נכשל אחרי ההוספה? לא משאירים שורה ריקה
    if (inserted) {
      try { sh.deleteRow(1); } catch (e2) {}
    }
  }
}


/**
 * מוחקת שורות ריקות לחלוטין שיושבות מעל הטבלה.
 * לניקוי גיליונות שכבר נפגעו.
 */
function cleanTopRows() {
  if (!guard_()) return;
  const ss = SpreadsheetApp.getActive();

  const SKIP = (CFG.MANUAL_SHEETS || [])
    .concat(CFG.NO_FORMAT || []).concat([CFG.SRC, 'מסך בית']);

  let removed = 0;
  const report = [];

  ss.getSheets().forEach(function (sh) {
    if (SKIP.indexOf(sh.getName()) !== -1) return;
    if (sh.getLastRow() < 2) return;

    let here = 0, guard = 0;
    while (guard++ < 10 && sh.getMaxRows() > 2) {
      const cols = Math.max(sh.getLastColumn(), 1);
      const r1 = sh.getRange(1, 1, 1, cols).getValues()[0];
      const r2 = sh.getRange(2, 1, 1, cols).getValues()[0];

      const empty1 = r1.every(function (v) { return String(v).trim() === ''; });
      const has2 = r2.some(function (v) { return String(v).trim() !== ''; });
      if (!empty1 || !has2) break;

      try { sh.getRange(1, 1, 1, sh.getMaxColumns()).breakApart(); }
      catch (err) {}
      sh.deleteRow(1);
      here++;
    }

    if (here) {
      // הקיפאון חייב לרדת יחד עם השורות, אחרת שורת הנתונים
      // הראשונה נשארת תקועה מתחת לפס הקפוא
      try {
        const fr = sh.getFrozenRows();
        if (fr > 0) sh.setFrozenRows(Math.max(fr - here, 1));
      } catch (err) {}

      report.push(sh.getName() + ': ' + here);
      removed += here;
    }
  });

  const msg = removed
    ? 'נמחקו ' + removed + ' שורות ריקות.\n\n' + report.join('\n')
    : 'לא נמצאו שורות ריקות בראש הגיליונות.';

  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert('ניקוי שורות ריקות', msg, ui.ButtonSet.OK);
  } catch (err) {
    try { ss.toast(msg, 'ניקוי שורות', 15); } catch (e2) {}
  }
  return removed;
}


function clearBeyondTable_(sh, cols, rows) {
  const maxC = sh.getMaxColumns(), maxR = sh.getMaxRows();

  // גבול הבטיחות: אף גרף לא ייפגע. אם גרף מעוגן מעבר לטבלה,
  // לא נוגעים בכלום מאותה עמודה או שורה והלאה.
  let safeCol = maxC, safeRow = maxR;
  try {
    sh.getCharts().forEach(function (ch) {
      const a = ch.getContainerInfo();
      if (a.getAnchorColumn() <= safeCol) safeCol = a.getAnchorColumn() - 1;
      if (a.getAnchorRow() <= safeRow) safeRow = a.getAnchorRow() - 1;
    });
  } catch (err) { return; }

  // ניקוי עמודות שמימין לטבלה — רק אם הן ריקות לחלוטין
  try {
    for (let c = cols + 1; c <= Math.min(maxC, safeCol); c++) {
      const vals = sh.getRange(1, c, maxR, 1).getValues();
      const empty = vals.every(function (r) { return String(r[0]).trim() === ''; });
      if (!empty) continue;                       // יש שם תוכן — לא נוגעים
      sh.getRange(1, c, maxR, 1).clearFormat()
        .setBackground(null)
        .setBorder(false, false, false, false, false, false);
    }
  } catch (err) {}

  // ניקוי שורות שמתחת לטבלה — רק אם הן ריקות לחלוטין
  try {
    const top = rows + 1;
    const bottom = Math.min(maxR, safeRow);
    if (bottom >= top) {
      const block = sh.getRange(top, 1, bottom - top + 1, maxC).getValues();
      let last = -1;
      for (let i = block.length - 1; i >= 0; i--) {
        const any = block[i].some(function (v) { return String(v).trim() !== ''; });
        if (any) { last = i; break; }
      }
      const firstEmpty = top + last + 1;          // השורה הריקה הראשונה
      if (firstEmpty <= bottom) {
        sh.getRange(firstEmpty, 1, bottom - firstEmpty + 1, maxC).clearFormat()
          .setBackground(null)
          .setBorder(false, false, false, false, false, false);
      }
    }
  } catch (err) {}
}


function styleOutput_(sh, cols, dataRows, family, groups) {
  const n = Math.max(dataRows || 0, 0);
  sh.setRightToLeft(true);
  sh.setHiddenGridlines(true);
  if (family && TABS[family]) sh.setTabColor(TABS[family]);

  sh.getRange(1, 1, 1, cols)
    .setBackground(THEME.HEAD_BG).setFontColor(THEME.INK_STRONG)
    .setFontFamily('Arial').setFontWeight('bold').setFontSize(11)
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
  sh.setRowHeight(1, 56);

  if (n > 0) {
    const body = sh.getRange(2, 1, n, cols);
    body.setFontFamily('Arial').setFontSize(11).setFontColor(THEME.INK)
        .setFontWeight('normal')
        .setVerticalAlignment('middle').setHorizontalAlignment('center');
    sh.getRange(2, 1, n, 1).setHorizontalAlignment('right')
      .setFontWeight('bold').setFontColor(THEME.INK_STRONG);
    try {
      body.getBandings().forEach(function (b) { b.remove(); });
      body.applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, false, false);
      const bd = body.getBandings()[0];
      if (bd) bd.setHeaderRowColor(null).setFirstRowColor(THEME.BAND_A)
               .setSecondRowColor(THEME.BAND_B).setFooterRowColor(null);
    } catch (err) {}
    sh.setRowHeights(2, n, 28);
  }

  frameTable_(sh, 1, 1, n + 1, cols, groups);

  sh.autoResizeColumns(1, cols);
  for (let i = 1; i <= cols; i++) {
    const w = sh.getColumnWidth(i);
    if (w < 95) sh.setColumnWidth(i, 95);
    if (w > 300) sh.setColumnWidth(i, 300);
  }
  sh.setColumnWidth(1, 185);
  sh.setFrozenRows(1);
  sh.setFrozenColumns(1);

  clearBeyondTable_(sh, cols, n + 1);
}


function colorScoreColumns_(sh, firstCol, count, rows) {
  if (!rows) return;
  const rng = sh.getRange(2, firstCol, rows, count);

  // כלל gradient לא יכול לקבוע צבע גופן, ולכן קובעים אותו
  // כאן על התא עצמו. הוא נראה מתחת לרקע שהכלל צובע.
  rng.setFontColor('#000000');

  const rules = sh.getConditionalFormatRules();
  rules.push(SpreadsheetApp.newConditionalFormatRule().setRanges([rng])
    .setGradientMinpointWithValue(THEME.S1, SpreadsheetApp.InterpolationType.NUMBER, '1')
    .setGradientMidpointWithValue(THEME.S3, SpreadsheetApp.InterpolationType.NUMBER, '3')
    .setGradientMaxpointWithValue(THEME.S5, SpreadsheetApp.InterpolationType.NUMBER, '5')
    .build());
  sh.setConditionalFormatRules(rules);
}


/**
 * עיצוב אחיד לכל הגרפים בקובץ.
 * שינוי כאן משנה את כל הגרפים בבת אחת.
 */
function chartBase_(title) {
  return {
    title: title || '',
    backgroundColor: { fill: '#FFFFFF', stroke: THEME.LINE || '#DFE3E6', strokeWidth: 1 },
    fontName: 'Arial',
    fontSize: 12,
    titleTextStyle: { fontName: 'Arial', fontSize: 15, bold: true,
                      color: THEME.INK_STRONG },
    chartArea: { width: '74%', height: '64%' },
    hAxis: {
      textStyle: { color: THEME.INK_SOFT, fontSize: 11 },
      titleTextStyle: { color: THEME.INK_SOFT, fontSize: 11, italic: false },
      baselineColor: '#B0BEC5',
      gridlines: { color: 'transparent' }
    },
    vAxis: {
      textStyle: { color: THEME.INK_SOFT, fontSize: 11 },
      baselineColor: '#B0BEC5',
      gridlines: { color: '#EEF1F2', count: 5 },
      minorGridlines: { count: 0 }
    },
    legend: { position: 'none' },
    tooltip: { textStyle: { fontName: 'Arial', fontSize: 12 } },
    focusTarget: 'category'
  };
}

/** מחיל אובייקט אפשרויות על בונה גרף. */
function applyOpts_(b, opts) {
  Object.keys(opts).forEach(function (k) { b = b.setOption(k, opts[k]); });
  return b;
}


function labelOpts_() {
  return {
    series: [{ dataLabel: 'value', dataLabelPlacement: 'outsideEnd' }],
    annotations: { alwaysOutside: true,
      textStyle: { fontSize: 11, color: THEME.INK, auraColor: 'none' } },
    dataLabels: 'value'
  };
}


/**
 * מוסיף את הערך לשם הקטגוריה: "תאמר (12)".
 * גוגל לא תמיד מכבדת את הגדרת התוויות מהקוד, וכך המספר
 * נראה תמיד — בלי לרחף מעל העמודה.
 */
function withValues_(rows) {
  return rows.map(function (r, i) {
    if (i === 0) return r;
    return [String(r[0]) + '  (' + r[1] + ')', r[1]];
  });
}


function addTop5Chart_(sh, out, nameIdx, valIdx, title, tableCols, color) {
  if (!out || !out.length) return;
  const top = out.filter(function (r) { return num_(r[valIdx]) !== null; })
                 .slice(0, 5)
                 .map(function (r) { return [String(r[nameIdx]), num_(r[valIdx])]; });
  if (!top.length) return;

  const H = tableCols + 1;
  ensureCols_(sh, H + 2);
  ensureRows_(sh, out.length + 26);

  const data = [['שם', 'ערך']].concat(top);
  sh.getRange(1, H, data.length, 2).setValues(data);

  const opts = chartBase_(title);
  opts.colors = [color || THEME.CHART[0]];
  opts.chartArea = { width: '62%', height: '74%' };
  opts.bar = { groupWidth: '62%' };
  opts.annotations = {
    alwaysOutside: true,
    textStyle: { fontName: 'Arial', fontSize: 11, bold: true,
                 color: THEME.INK, auraColor: 'none' }
  };
  opts.series = [{ dataLabel: 'value' }];

  let b = sh.newChart().setChartType(Charts.ChartType.BAR)
    .addRange(sh.getRange(1, H, data.length, 2))
    .setPosition(out.length + 4, 1, 0, 0)
    .setOption('width', 620).setOption('height', 300);

  b = applyOpts_(b, opts);
  sh.insertChart(b.build());
  sh.hideColumns(H, 2);
}

function num_(v) {
  const x = Number(v);
  return (v === '' || v === null || v === undefined || isNaN(x)) ? null : x;
}
function avg_(sum, n) { return n ? Math.round((sum / n) * 10) / 10 : ''; }
function daysSince_(d) {
  if (!(d instanceof Date)) return null;
  return Math.floor((new Date() - d) / 86400000);
}
function colLetter_(i) {
  let n = i + 1, s = '';
  while (n) { const r = (n - 1) % 26; s = String.fromCharCode(65 + r) + s; n = (n - 1 - r) / 26; }
  return s;
}
/** קישור שמקפיץ לשורה בגיליון הראשי. */
function rowLink_(row) {
  const sh = SpreadsheetApp.getActive().getSheetByName(CFG.SRC);
  const gid = sh ? sh.getSheetId() : 0;
  return '=HYPERLINK("#gid=' + gid + '&range=C' + row + '","שורה ' + row + '")';
}

function schoolStart_() {
  return new Date(CFG.SCHOOL_START[0], CFG.SCHOOL_START[1], CFG.SCHOOL_START[2]);
}
function schoolWeek_(d) {
  if (!(d instanceof Date)) return 0;
  const start = schoolStart_();
  const x = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  if (x < start) return 0;
  return Math.floor((x - start) / (7 * 86400000)) + 1;
}
function weekStartOf_(n) {
  const d = schoolStart_();
  d.setDate(d.getDate() + (n - 1) * 7);
  return d;
}
/** מחזיר את שם הסמסטר של תאריך, או '' אם מחוץ לטווח. */
function semesterOf_(d) {
  if (!(d instanceof Date)) return '';
  for (let i = 0; i < CFG.SEMESTERS.length; i++) {
    const s = CFG.SEMESTERS[i];
    const a = new Date(s[1][0], s[1][1], s[1][2]);
    const b = new Date(s[2][0], s[2][1], s[2][2], 23, 59, 59);
    if (d >= a && d <= b) return s[0];
  }
  return '';
}
function currentSemester_() {
  const s = semesterOf_(new Date());
  return s || CFG.SEMESTERS[CFG.SEMESTERS.length - 1][0];
}
function sortDesc_(arr, idx) {
  arr.sort(function (a, b) {
    const x = num_(a[idx]), y = num_(b[idx]);
    if (x === null && y === null) return 0;
    if (x === null) return 1;
    if (y === null) return -1;
    return y - x;
  });
}
/** מוסיף גרש למחזור: ז -> ז' ; מזהה גם ערך שכבר תקין. */
function normMachzor_(v) {
  const s = String(v || '').trim().replace(/['\u05f3"]/g, '');
  if (!s) return '';
  const hit = CFG.MACHZOR_LIST.filter(function (x) {
    return x.replace(/'/g, '') === s;
  })[0];
  return hit || String(v || '').trim();
}

/** מתרגם שם גיאוגרפי לשם פלוגה, אם הוגדרה התאמה. */
function normPlugah_(v) {
  const s = String(v || '').trim();
  if (!s) return '';
  if (CFG.PLUGAH_LIST.indexOf(s) !== -1) return s;
  const mapped = CFG.PLUGAH_MAP[s];
  return mapped ? mapped : s;
}

function only_(arr) { return (arr && arr.length === 1) ? arr[0] : ''; }
function showAll_(arr) { return (arr && arr.length) ? arr.join(' / ') : ''; }



/* ============================================================================
   פרק 2 — טבלת המיפוי
   ============================================================================
   שורה לכל צירוף של מש"קית + רשות + מנה"ד.
   המפקדת והמ.א שלה נקבעות ברמת המש"קית — תמיד אחת. סתירה
   בין שורות מסומנת כשגיאה בגיליון "איכות נתונים".
   ============================================================================ */

const MAP_HEAD = ['מש"קית', 'מספר אישי', 'מחזור', 'פלוגה', 'מחוז', 'רשות',
                  'מפקדת', 'מ.א מפקדת', 'מנה"ד', 'מה חסר'];

function buildMappingSheet() {
  if (!guard_()) return;
  clearMappingCache_();
  syncRosterFromFile(true);
}

var _MAP_CACHE = null;

/** מאפס את זיכרון טבלת המיפוי. נקרא אחרי כל בנייה שלה. */
function clearMappingCache_() { _MAP_CACHE = null; }

function getMapping_() {
  if (_MAP_CACHE) return _MAP_CACHE;
  const sh = SpreadsheetApp.getActive().getSheetByName(CFG.MAPPING_SHEET);
  const map = {};
  if (!sh || sh.getLastRow() < 2) return map;

  // מדלגים על שורת התיאור אם היא קיימת
  const hdrRow = String(sh.getRange(1, 1).getValue()).trim() === MAP_HEAD[0] ? 1 : 2;
  const first = hdrRow + 1;
  if (sh.getLastRow() < first) return map;

  sh.getRange(first, 1, sh.getLastRow() - hdrRow, MAP_HEAD.length).getValues()
    .forEach(function (r) {
      const name = String(r[0]).trim();
      if (!name) return;
      if (!map[name]) map[name] = {
        rows: [], pid: [], machzor: [], plugah: [], mahoz: [],
        rashut: [], mef: [], maMef: [], manhad: []
      };
      const e = map[name];
      const row = {
        pid: String(r[1] || '').trim(), machzor: String(r[2] || '').trim(),
        plugah: String(r[3] || '').trim(), mahoz: String(r[4] || '').trim(),
        rashut: String(r[5] || '').trim(), mef: String(r[6] || '').trim(),
        maMef: String(r[7] || '').trim(), manhad: String(r[8] || '').trim()
      };
      e.rows.push(row);
      ['pid','machzor','plugah','mahoz','rashut','mef','maMef','manhad']
        .forEach(function (f) {
          if (row[f] && e[f].indexOf(row[f]) === -1) e[f].push(row[f]);
        });
    });
  _MAP_CACHE = map;
  return map;
}

/* ============================================================================
   פרק 3 — מילוי אוטומטי
   ============================================================================
   שלב א: נבחרה מש"קית -> ממלאים כל שדה עם ערך יחיד.
           המפקדת והמ.א שלה תמיד מתמלאות, כי הן אחת לכל מש"קית.
   שלב ב: נבחרה רשות   -> מצמצמים לאותה רשות וממלאים מחוז ומנה"ד.
   ============================================================================ */

function autoFillFromMapping_(e) {
  try {
    const sh = e.range.getSheet();
    if (sh.getName() !== CFG.SRC) return;
    const row = e.range.getRow();
    if (row < CFG.FIRST_ROW) return;
    if (e.range.getNumRows() > 1 || e.range.getNumColumns() > 1) return;

    const m = colMap_(sh);
    const col = e.range.getColumn();
    const iMash   = findCol_(m, 'משקית') + 1;
    const iRashut = findCol_(m, 'רשות') + 1;
    if (col !== iMash && col !== iRashut) return;

    const name = String(sh.getRange(row, iMash).getValue()).trim();
    if (!name) return;
    const entry = getMapping_()[name];
    if (!entry) return;

    let pool = entry.rows;
    const chosen = iRashut > 0
      ? String(sh.getRange(row, iRashut).getValue()).trim() : '';
    if (chosen) {
      const narrowed = pool.filter(function (r) { return r.rashut === chosen; });
      if (narrowed.length) pool = narrowed;
    }
    const uniq = function (f) {
      const s = [];
      pool.forEach(function (r) { if (r[f] && s.indexOf(r[f]) === -1) s.push(r[f]); });
      return s.length === 1 ? s[0] : '';
    };

    // הפלוגה נקבעת לפי הרשות שבשורה, לא לפי המש"קית
    let plugah = '';
    const rashutNow = chosen || uniq('rashut');
    if (rashutNow) {
      const pt = getPlugahByRashut_();
      plugah = pt[normRashut_(rashutNow)] || '';
    }

    const pairs = [
      ['מ.א מש"קית', only_(entry.pid) || uniq('pid')],
      ['מחזור',      only_(entry.machzor) || uniq('machzor')],
      ['פלוגה',      plugah],
      ['מחוז',       uniq('mahoz')],
      ['רשות',       uniq('rashut')],
      ['מפקדת',      only_(entry.mef) || uniq('mef')],
      ['מ.א מפקדת',  only_(entry.maMef) || uniq('maMef')],
      ['מנהד אזורי', uniq('manhad')]
    ];

    pairs.forEach(function (p) {
      if (!p[1]) return;
      // הערך שהמשתמש בחר בעמודת הרשות לא נדרס על ידי עצמו
      if (p[0] === 'רשות' && col === iRashut) return;
      const idx = findCol_(m, p[0]);
      if (idx < 0) return;
      const cell = sh.getRange(row, idx + 1);
      if (cell.getFormula()) return;   // נוסחה לא נדרסת לעולם
      cell.setValue(p[1]);             // טבלת המיפוי היא טבלת האמת
    });
  } catch (err) {}
}

function fillAllFromMapping() {
  if (!guard_()) return;
  clearObsCache_();
  const ss = SpreadsheetApp.getActive();
  const o = getObservations_();
  const sh = o.sheet;
  const m = o.map;
  const mapping = getMapping_();
  const n = o.lastRow - CFG.FIRST_ROW + 1;
  if (n < 1) { ss.toast('אין שורות למילוי'); return; }

  const F = {
    mash:    findCol_(m, 'משקית'),      pid:    findCol_(m, 'מ.א מש"קית'),
    machzor: findCol_(m, 'מחזור'),      plugah: findCol_(m, 'פלוגה'),
    mahoz:   findCol_(m, 'מחוז'),       rashut: findCol_(m, 'רשות'),
    mef:     findCol_(m, 'מפקדת'),      maMef:  findCol_(m, 'מ.א מפקדת'),
    manhad:  findCol_(m, 'מנהד אזורי')
  };
  if (F.mash < 0) { ss.toast('לא נמצאה עמודת מש"קית'); return; }

  // קוראים רק את העמודות שנדרשות, וכותבים רק אותן.
  //
  // חשוב: getValues מחזיר את התוצאה של נוסחה ולא את הנוסחה עצמה.
  // גרסה קודמת קראה את כל רוחב השורה וכתבה בחזרה — וכך הפכה כל
  // נוסחה בשורה לערך קבוע, כולל נוסחת הציון. מכאן והלאה נוגעים
  // אך ורק בעמודות היעד, ורק בתאים שאין בהם נוסחה.
  const TARGETS = ['pid','machzor','plugah','mahoz','rashut','mef','maMef','manhad'];
  const SRC_KEY = { pid:'pid', machzor:'machzor', plugah:'plugah', mahoz:'mahoz',
                    rashut:'rashut', mef:'mef', maMef:'maMef', manhad:'manhad' };

  const names = sh.getRange(CFG.FIRST_ROW, F.mash + 1, n, 1).getValues();
  const cur = {}, fml = {};
  TARGETS.forEach(function (k) {
    if (F[k] < 0) return;
    const rng = sh.getRange(CFG.FIRST_ROW, F[k] + 1, n, 1);
    cur[k] = rng.getValues();
    fml[k] = rng.getFormulas();
  });
  const rashutCur = F.rashut >= 0 ? cur.rashut : null;

  let filled = 0;
  const touched = {};

  for (let i = 0; i < n; i++) {
    const name = String(names[i][0] || '').trim();
    if (!name) continue;
    const entry = mapping[name];
    if (!entry) continue;

    let pool = entry.rows;
    const chosen = rashutCur ? String(rashutCur[i][0] || '').trim() : '';
    if (chosen) {
      const narrowed = pool.filter(function (x) { return x.rashut === chosen; });
      if (narrowed.length) pool = narrowed;
    }
    const uniq = function (f) {
      const s = [];
      pool.forEach(function (x) { if (x[f] && s.indexOf(x[f]) === -1) s.push(x[f]); });
      return s.length === 1 ? s[0] : '';
    };

    TARGETS.forEach(function (k) {
      if (F[k] < 0) return;
      if (String(fml[k][i][0] || '') !== '') return;        // תא נוסחה — לא נוגעים
      if (String(cur[k][i][0] || '').trim() !== '') return; // כבר מולא
      let v = '';
      if (k === 'pid')      v = only_(entry.pid) || uniq('pid');
      else if (k === 'mef') v = only_(entry.mef) || uniq('mef');
      else if (k === 'maMef') v = only_(entry.maMef) || uniq('maMef');
      else if (k === 'machzor') v = only_(entry.machzor) || uniq('machzor');
      else v = uniq(SRC_KEY[k]);
      if (!v) return;
      cur[k][i][0] = v;
      touched[k] = true;
      filled++;
    });
  }

  Object.keys(touched).forEach(function (k) {
    sh.getRange(CFG.FIRST_ROW, F[k] + 1, n, 1).setValues(cur[k]);
  });

  ss.toast('הושלמו ' + filled + ' תאים', 'מילוי מהמיפוי', 10);
}

/* ============================================================================
   פרק 4 — עבודה שוטפת
   ============================================================================ */

/* ============================================================================
   פרק 42 — נוסחאות שליפה מטבלת המיפוי
   ============================================================================
   שמונה עמודות הזיהוי נשלפות מ"מיפוי" לפי המש"קית שנבחרה.

   העמודות שיכולות להשתנות בין שיוך לשיוך (רשות, מפקדת,
   מ.א מפקדת, מנה"ד, פלוגה, מחוז) מוגנות בבדיקת COUNTIF:
   אם למש"קית יש יותר משורה אחת במיפוי, התא נשאר ריק
   במקום לנחש את הראשונה.
   ============================================================================ */

/* ============================================================================
   פרק 47 — הדבקת נוסחאות השליפה כערכים
   ============================================================================
   נוסחת השליפה מחזירה תמיד את השיוך הנוכחי במיפוי. זה נכון
   לשורה שממלאים עכשיו, ולא נכון לתצפית מלפני חודשיים: אם
   מש"קית עברה רשות, הדוח של ספטמבר ישתנה בדצמבר.

   ההדבקה ממירה את הנוסחה לערך שהיא מחזירה באותו רגע. שום
   נתון לא נמחק ולא משתנה — רק מפסיק לזוז.

   מתי
   ----
   pasteLookupValuesWeekly יושבת בתוך ההרצה היומית ובודקת
   את היום בשבוע. ביום CFG.PASTE_DAY היא עובדת, בשאר הימים
   היא יוצאת מיד. אין טריגר נפרד.

   על מה לא נוגעים
   ----------------
   שורה בלי מש"קית — הנוסחאות נשארות חיות, אחרת ההשלמה
   האוטומטית תפסיק לעבוד בשורות הבאות.

   תא שהנוסחה החזירה בו ריק — למש"קית יש כמה שורות במיפוי
   והנוסחה סירבה לנחש. הדבקת ריק הייתה מקבעת את החוסר, ולכן
   הנוסחה נשארת ומנסה שוב בשבוע הבא.

   תיקון אחרי ההדבקה
   -------------------
   שינוי מש"קית בשורה צרובה מפעיל את autoFillFromMapping_,
   שמשלים את שבעת השדות מחדש מטבלת המיפוי. הפונקציה הזו
   כותבת ערכים ולא נוסחאות, ולכן היא עובדת בשורה צרובה בדיוק
   כמו בשורה חיה. אין מצב שבו שורה "נסגרת" לעריכה.
   ============================================================================ */

/**
 * המנוע. אוסף את השורות שיש בהן מש"קית ונוסחה שהחזירה ערך,
 * ומדביק בהן את הערך במקום הנוסחה.
 *
 * opts.limit    כמה שורות לכל היותר. 0 = הכל.
 * opts.confirm  להציג תצוגה מקדימה ולחכות לאישור.
 * opts.silent   בלי חלון סיום.
 */
function pasteRun_(opts) {
  opts = opts || {};
  const limit = Number(opts.limit || 0);
  if (!guard_()) return 0;
  clearObsCache_();

  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SRC);
  if (!sh) { if (!opts.silent) ss.toast('לא נמצא גיליון ההזנה'); return 0; }

  const m = colMap_(sh);
  const iMash = findCol_(m, 'משקית');
  if (iMash < 0) { if (!opts.silent) ss.toast('לא נמצאה עמודת מש"קית'); return 0; }

  const cols = (CFG.LOOKUP_COLS || [])
    .map(function (t) { return { title: t, idx: findCol_(m, t) }; })
    .filter(function (x) { return x.idx >= 0; });
  if (!cols.length) { if (!opts.silent) ss.toast('לא נמצאו עמודות שליפה'); return 0; }

  const first = Math.max(CFG.LOOKUP_START_ROW || CFG.FIRST_ROW, CFG.FIRST_ROW);
  const n = sh.getMaxRows() - first + 1;
  if (n < 1) return 0;

  /* ---------- קריאה אחת ---------- */
  const mash = sh.getRange(first, iMash + 1, n, 1).getValues();
  const F = {}, V = {};
  cols.forEach(function (c) {
    const r = sh.getRange(first, c.idx + 1, n, 1);
    F[c.idx] = r.getFormulas();
    V[c.idx] = r.getValues();
  });

  /* ---------- מי מועמד ---------- */
  const cands = [];
  let openCells = 0;

  for (let x = 0; x < n; x++) {
    if (String(mash[x][0] || '').trim() === '') continue;   // שורה פנויה

    const cells = [];
    cols.forEach(function (c) {
      const f = String(F[c.idx][x][0] || '');
      if (!f) return;                                       // כבר ערך קבוע
      const v = V[c.idx][x][0];
      if (String(v === null ? '' : v).trim() === '') { openCells++; return; }
      cells.push({ idx: c.idx, title: c.title, value: v });
    });

    if (cells.length) cands.push({ row: first + x, x: x, cells: cells });
    if (limit && cands.length >= limit) break;
  }

  if (!cands.length) {
    if (opts.silent) return 0;
    const none = 'אין מה להדביק.\n\n' +
      'מועמדת היא שורה שיש בה מש"קית ושהנוסחה החזירה בה ערך, ' +
      'משורה ' + first + ' והלאה.\n\n' +
      'שורות ' + CFG.FIRST_ROW + ' עד ' + (first - 1) + ' אינן מועמדות — ' +
      'אין בהן נוסחאות, הן ערכים קבועים.' +
      (openCells ? '\n\n' + openCells + ' תאים מחזיקים נוסחה שהחזירה ריק ' +
                   '(למש"קית כמה שיוכים במיפוי). הם נשארים כמו שהם.' : '');
    alert_('הדבקת נוסחאות כערכים', none);
    return 0;
  }

  /* ---------- תצוגה מקדימה ---------- */
  if (opts.confirm) {
    let txt = 'זה מה שישתנה:\n';
    cands.forEach(function (c) {
      txt += '\nשורה ' + c.row + '\n';
      c.cells.forEach(function (cell) {
        txt += '    ' + cell.title + '  ←  ' + cell.value + '\n';
      });
    });
    txt += '\nהנוסחה בתאים האלה תוחלף בערך שהיא מחזירה כרגע. ' +
           'הערך עצמו לא משתנה — הוא רק מפסיק להיות מחושב.\n\n' +
           'השורות האלה לא יושפעו יותר משינויים בקובץ "כא גשרים", ' +
           'ואפשר עדיין לערוך אותן ידנית. אם תשנה בהן מש"קית, ' +
           'ההשלמה האוטומטית תמלא אותן מחדש.\n\n' +
           'להדביק?';

    let ui;
    try { ui = SpreadsheetApp.getUi(); } catch (err) { ui = null; }
    if (!ui) return 0;
    if (ui.alert('דוגמה — ' + cands.length + ' שורות', txt,
                 ui.ButtonSet.YES_NO) !== ui.Button.YES) {
      ss.toast('בוטל. שום דבר לא השתנה.', 'דוגמה', 6);
      return 0;
    }
  }

  /* ---------- כתיבה ---------- */
  let cells = 0;

  if (limit) {
    // מעט תאים — כותבים בדיוק אותם ולא נוגעים בשאר העמודה
    cands.forEach(function (c) {
      c.cells.forEach(function (cell) {
        sh.getRange(c.row, cell.idx + 1).setValue(cell.value);
        cells++;
      });
    });
  } else {
    const doRow = {};
    cands.forEach(function (c) { doRow[c.x] = {}; 
      c.cells.forEach(function (cell) { doRow[c.x][cell.idx] = cell.value; }); });

    cols.forEach(function (c) {
      const out = [];
      let changed = false;
      for (let x = 0; x < n; x++) {
        const f = String(F[c.idx][x][0] || '');
        if (doRow[x] && doRow[x][c.idx] !== undefined) {
          out.push([doRow[x][c.idx]]);
          changed = true;
          cells++;
        } else {
          out.push([f ? f : V[c.idx][x][0]]);
        }
      }
      if (changed) sh.getRange(first, c.idx + 1, n, 1).setValues(out);
    });
  }

  SpreadsheetApp.flush();
  if (opts.silent) return cands.length;

  const msg = 'הודבקו ' + cands.length + ' שורות (' + cells + ' תאים).\n\n' +
    'השורות האלה לא ישתנו יותר, גם אם השיוך של המש"קית ' +
    'ישתנה בקובץ "כא גשרים".\n\n' +
    (openCells ? openCells + ' תאים נשארו עם נוסחה כי היא החזירה ריק ' +
                 '(למש"קית כמה שיוכים במיפוי). הם ינסו שוב בהדבקה הבאה.\n\n'
               : '') +
    'שורות פנויות נשארו עם נוסחאות חיות, וההשלמה האוטומטית ' +
    'ממשיכה לעבוד בכל השורות — כולל אלה שהודבקו.';

  alert_('הדבקת נוסחאות כערכים', msg);
  return cands.length;
}


